{
  "name": "nself-plugin-registry",
  "version": "1.0.0",
  "description": "Cloudflare Worker for nself plugin registry API",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "tail": "wrangler tail",
    "kv:create": "wrangler kv:namespace create PLUGINS_KV",
    "kv:list": "wrangler kv:namespace list",
    "secret:sync-token": "wrangler secret put GITHUB_SYNC_TOKEN",
    "whoami": "wrangler whoami",
    "typecheck": "tsc --noEmit",
    "bundle-test": "esbuild src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=dist-test/index.mjs --log-level=warning",
    "test": "pnpm run bundle-test && node --test src/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.152.0",
    "typescript": "^5.9.0",
    "@cloudflare/workers-types": "^5.20261023.1"
  },
  "keywords": [
    "nself",
    "plugin",
    "registry",
    "cloudflare-worker"
  ],
  "author": "nself-org",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nself-org/plugins.git",
    "directory": ".workers/plugins-registry"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}