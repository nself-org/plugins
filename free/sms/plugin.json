{
  "author": "nself-org",
  "category": "communication",
  "description": "SMS messaging via Twilio. Send, track, and manage opt-outs.",
  "envVars": [
    {
      "description": "Twilio Account SID",
      "name": "TWILIO_ACCOUNT_SID",
      "required": true
    },
    {
      "description": "Twilio Auth Token",
      "name": "TWILIO_AUTH_TOKEN",
      "required": true
    },
    {
      "description": "Twilio sending number (E.164)",
      "name": "TWILIO_FROM_NUMBER",
      "required": true
    },
    {
      "description": "PostgreSQL connection string",
      "name": "NSELF_DB_URL",
      "required": true
    },
    {
      "description": "HTTP server port",
      "name": "SMS_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "Max SMS per source_account per minute",
      "name": "SMS_RATE_LIMIT_PER_MIN",
      "required": false
    },
    {
      "description": "License key",
      "name": "NSELF_LICENSE_KEY",
      "required": false
    }
  ],
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "name": "sms",
  "port": 9009,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "schema": "np_sms",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 9009
  },
  "status": "stable",
  "tables": [
    "np_sms_messages",
    "np_sms_opt_outs"
  ],
  "tier": "free",
  "version": "1.2.6"
}
