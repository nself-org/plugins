{
  "author": "nself",
  "category": "infrastructure",
  "description": "File processing with thumbnails and optimization for MinIO/S3/GCS/R2/B2/Azure. Planned: Inbound webhook support for storage provider notifications",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "FILE_STORAGE_BUCKET",
      "required": true
    },
    {
      "description": "",
      "name": "FILE_STORAGE_PROVIDER",
      "required": true
    },
    {
      "description": "",
      "name": "FILE_STORAGE_ENDPOINT",
      "required": false
    },
    {
      "description": "",
      "name": "FILE_STORAGE_ACCESS_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "FILE_STORAGE_SECRET_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "FILE_STORAGE_REGION",
      "required": false
    },
    {
      "description": "",
      "name": "FILE_THUMBNAIL_SIZES",
      "required": false
    },
    {
      "description": "",
      "name": "FILE_ENABLE_OPTIMIZATION",
      "required": false
    },
    {
      "description": "",
      "name": "FILE_MAX_SIZE",
      "required": false
    },
    {
      "description": "",
      "name": "FILE_ALLOWED_TYPES",
      "required": false
    },
    {
      "description": "",
      "name": "FILE_STRIP_EXIF",
      "required": false
    },
    {
      "description": "",
      "name": "FILE_QUEUE_CONCURRENCY",
      "required": false
    },
    {
      "description": "",
      "name": "REDIS_URL",
      "required": false
    },
    {
      "description": "",
      "name": "PORT",
      "required": false
    },
    {
      "description": "",
      "name": "CORS_ALLOWED_ORIGIN",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "rust",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "file-processing",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache",
      "temp"
    ],
    "network": [
      "*"
    ]
  },
  "port": 3089,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/jobs"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/jobs"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/api/v1/jobs/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/jobs/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/metadata"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/metadata/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/stats"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/thumbnails"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/thumbnails/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ready"
    }
  ],
  "schema": "np_file_processing",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3089
  },
  "status": "stable",
  "tables": [
    "np_fileproc_jobs",
    "np_fileproc_thumbnails",
    "np_fileproc_metadata"
  ],
  "tags": [
    "files",
    "storage",
    "processing",
    "thumbnails",
    "optimization"
  ],
  "tier": "free",
  "version": "1.2.13"
}
