{
  "author": "nself",
  "category": "commerce",
  "description": "Shopify store, orders, and product synchronization",
  "entryPoint": "nself-shopify",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "SHOPIFY_ACCESS_TOKEN",
      "required": true
    },
    {
      "description": "",
      "name": "SHOPIFY_SHOP_DOMAIN",
      "required": true
    },
    {
      "description": "",
      "name": "SHOPIFY_API_VERSION",
      "required": false
    },
    {
      "description": "",
      "name": "SHOPIFY_WEBHOOK_SECRET",
      "required": false
    },
    {
      "description": "",
      "name": "SHOPIFY_SYNC_INTERVAL",
      "required": false
    },
    {
      "description": "",
      "name": "SHOPIFY_ACCESS_TOKENS",
      "required": false
    },
    {
      "description": "",
      "name": "SHOPIFY_SHOP_DOMAINS",
      "required": false
    },
    {
      "description": "",
      "name": "SHOPIFY_ACCOUNT_LABELS",
      "required": false
    },
    {
      "description": "",
      "name": "SHOPIFY_WEBHOOK_SECRETS",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "composite",
    "supported": true
  },
  "name": "shopify",
  "port": 3072,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "schema": "np_shopify",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3072
  },
  "status": "stable",
  "tables": [
    "np_shopify_shops",
    "np_shopify_products",
    "np_shopify_variants",
    "np_shopify_collections",
    "np_shopify_customers",
    "np_shopify_orders",
    "np_shopify_order_items",
    "np_shopify_inventory",
    "np_shopify_webhook_events"
  ],
  "tags": [
    "shopify",
    "ecommerce",
    "orders",
    "products",
    "inventory"
  ],
  "tier": "free",
  "version": "1.2.6",
  "webhooks": [
    "customers/create",
    "customers/update",
    "fulfillments/create",
    "inventory_levels/update",
    "orders/cancelled",
    "orders/create",
    "orders/fulfilled",
    "orders/paid",
    "orders/updated",
    "products/create",
    "products/delete",
    "products/update",
    "refunds/create"
  ]
}
