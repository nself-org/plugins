{
  "author": "nself",
  "category": "infrastructure",
  "description": "Multi-provider object storage with S3-compatible API, local storage, presigned URLs, and multipart uploads",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "OS_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "OS_STORAGE_BASE_PATH",
      "required": false
    },
    {
      "description": "",
      "name": "OS_DEFAULT_PROVIDER",
      "required": false
    },
    {
      "description": "",
      "name": "OS_S3_ENDPOINT",
      "required": false
    },
    {
      "description": "",
      "name": "OS_S3_REGION",
      "required": false
    },
    {
      "description": "",
      "name": "OS_S3_ACCESS_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "OS_S3_SECRET_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "OS_S3_BUCKET_PREFIX",
      "required": false
    },
    {
      "description": "",
      "name": "OS_PRESIGN_EXPIRY_SECONDS",
      "required": false
    },
    {
      "description": "",
      "name": "OS_MAX_UPLOAD_SIZE",
      "required": false
    },
    {
      "description": "",
      "name": "OS_MULTIPART_THRESHOLD",
      "required": false
    },
    {
      "description": "",
      "name": "OS_API_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "OS_RATE_LIMIT_MAX",
      "required": false
    },
    {
      "description": "",
      "name": "OS_RATE_LIMIT_WINDOW_MS",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "object-storage",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache",
      "storage"
    ],
    "network": [
      "s3.amazonaws.com",
      "*.r2.cloudflarestorage.com",
      "storage.googleapis.com",
      "*.blob.core.windows.net"
    ]
  },
  "port": 3301,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/access-logs"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/buckets"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/buckets"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/buckets/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/buckets/{id}"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/buckets/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/buckets/{id}/objects"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/buckets/{id}/objects"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/buckets/{id}/objects/{key}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/buckets/{id}/objects/{key}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/stats"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/upload-sessions"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/upload-sessions/{id}"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/upload-sessions/{id}"
    }
  ],
  "schema": "np_object_storage",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3301
  },
  "status": "stable",
  "tables": [
    "np_objstore_buckets",
    "np_objstore_objects",
    "np_objstore_upload_sessions",
    "np_objstore_access_logs",
    "np_objstore_webhook_events"
  ],
  "tags": [
    "storage",
    "s3",
    "minio",
    "r2",
    "gcs",
    "azure",
    "b2",
    "uploads",
    "presigned"
  ],
  "tier": "free",
  "version": "1.2.13",
  "webhooks": [
    "bucket.created",
    "bucket.deleted",
    "bucket.updated",
    "object.created",
    "object.deleted",
    "upload.aborted",
    "upload.completed"
  ]
}
