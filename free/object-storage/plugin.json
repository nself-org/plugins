{
  "name": "object-storage",
  "version": "1.1.2",
  "api_version": "1.0.0",
  "description": "Multi-provider object storage with S3-compatible API, local storage, presigned URLs, and multipart uploads",
  "author": "nself",
  "license": "MIT",
  "isCommercial": false,
  "licenseType": "free",
  "requiredEntitlements": [],
  "requires_license": false,
  "homepage": "https://nself.org/plugins",
  "repository": "https://github.com/nself-org/plugins-pro",
  "minNselfVersion": "1.0.0",
  "port": 3301,
  "category": "infrastructure",
  "tags": [
    "storage",
    "s3",
    "minio",
    "r2",
    "gcs",
    "azure",
    "b2",
    "uploads",
    "presigned"
  ],
  "tables": [
    "np_objstore_buckets",
    "np_objstore_objects",
    "np_objstore_upload_sessions",
    "np_objstore_access_logs",
    "np_objstore_webhook_events"
  ],
  "webhooks": {
    "bucket.created": "Sync new bucket to database",
    "bucket.updated": "Update bucket configuration",
    "bucket.deleted": "Mark bucket as deleted",
    "object.created": "Track new object upload",
    "object.deleted": "Remove object from tracking",
    "upload.completed": "Mark multipart upload as completed",
    "upload.aborted": "Mark multipart upload as aborted"
  },
  "actions": {
    "init": "Initialize object storage schema",
    "server": "Start HTTP server for uploads and API",
    "buckets": "Manage storage buckets",
    "objects": "Manage stored objects",
    "upload": "Upload files to storage",
    "download": "Download files from storage",
    "presign": "Generate presigned URLs",
    "usage": "View storage usage statistics",
    "lifecycle": "Manage lifecycle rules"
  },
  "envVars": {
    "required": [
      "DATABASE_URL"
    ],
    "optional": [
      "OS_PLUGIN_PORT",
      "OS_STORAGE_BASE_PATH",
      "OS_DEFAULT_PROVIDER",
      "OS_S3_ENDPOINT",
      "OS_S3_REGION",
      "OS_S3_ACCESS_KEY",
      "OS_S3_SECRET_KEY",
      "OS_S3_BUCKET_PREFIX",
      "OS_PRESIGN_EXPIRY_SECONDS",
      "OS_MAX_UPLOAD_SIZE",
      "OS_MULTIPART_THRESHOLD",
      "OS_API_KEY",
      "OS_RATE_LIMIT_MAX",
      "OS_RATE_LIMIT_WINDOW_MS"
    ]
  },
  "config": {
    "defaultProvider": "local",
    "storageBasePath": "/data/object-storage",
    "presignExpirySeconds": 3600,
    "maxUploadSize": 1073741824,
    "multipartThreshold": 104857600
  },
  "hooks": {
    "postInstall": null,
    "preUninstall": null,
    "postSync": null
  },
  "multiApp": {
    "supported": true,
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "defaultValue": "primary"
  },
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "network": [
      "s3.amazonaws.com",
      "*.r2.cloudflarestorage.com",
      "storage.googleapis.com",
      "*.blob.core.windows.net"
    ],
    "filesystem": [
      "logs",
      "cache",
      "storage"
    ]
  },
  "status": "stable",
  "tier": "free",
  "language": "go",
  "routes": [
    {
      "method": "GET",
      "path": "/access-logs",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/buckets",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/buckets",
      "auth": "bearer"
    },
    {
      "method": "DELETE",
      "path": "/buckets/{id}",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/buckets/{id}",
      "auth": "bearer"
    },
    {
      "method": "PUT",
      "path": "/buckets/{id}",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/buckets/{id}/objects",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/buckets/{id}/objects",
      "auth": "bearer"
    },
    {
      "method": "DELETE",
      "path": "/buckets/{id}/objects/{key}",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/buckets/{id}/objects/{key}",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/health",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/stats",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/upload-sessions",
      "auth": "bearer"
    },
    {
      "method": "DELETE",
      "path": "/upload-sessions/{id}",
      "auth": "bearer"
    },
    {
      "method": "PUT",
      "path": "/upload-sessions/{id}",
      "auth": "bearer"
    }
  ],
  "dependencies": {
    "required": [],
    "optional": []
  },
  "entry": "cmd/main.go",
  "checksum": "54e76b6a892452cbed6ba802a7fb6d75e2b465ec9a02e40a93879b609a90ddf4",
  "bundles": [
    "clawde",
    "ntv",
    "nfamily"
  ]
}
