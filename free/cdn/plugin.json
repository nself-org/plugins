{
  "author": "nself",
  "category": "infrastructure",
  "description": "CDN management and integration plugin - cache purging, signed URLs. Planned: analytics sync from Cloudflare/BunnyCDN",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "CDN_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "CDN_PROVIDER",
      "required": false
    },
    {
      "description": "",
      "name": "CDN_CLOUDFLARE_API_TOKEN",
      "required": false
    },
    {
      "description": "",
      "name": "CDN_CLOUDFLARE_ZONE_IDS",
      "required": false
    },
    {
      "description": "",
      "name": "CDN_BUNNYCDN_API_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "CDN_BUNNYCDN_PULL_ZONE_IDS",
      "required": false
    },
    {
      "description": "",
      "name": "CDN_SIGNING_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "CDN_SIGNED_URL_TTL",
      "required": false
    },
    {
      "description": "",
      "name": "CDN_ANALYTICS_SYNC_INTERVAL",
      "required": false
    },
    {
      "description": "",
      "name": "CDN_PURGE_BATCH_SIZE",
      "required": false
    },
    {
      "description": "",
      "name": "CDN_API_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "CDN_RATE_LIMIT_MAX",
      "required": false
    },
    {
      "description": "",
      "name": "CDN_RATE_LIMIT_WINDOW_MS",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "cdn",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache"
    ],
    "network": [
      "*"
    ]
  },
  "port": 3036,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/analytics"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/purge"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/purge-requests"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/signed-urls"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/signed-urls"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/api/v1/signed-urls/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/stats"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/zones"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/zones"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/api/v1/zones/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/zones/{id}"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/api/v1/zones/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ready"
    }
  ],
  "schema": "np_cdn",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3036
  },
  "status": "stable",
  "tables": [
    "np_cdn_zones",
    "np_cdn_purge_requests",
    "np_cdn_analytics",
    "np_cdn_signed_urls"
  ],
  "tags": [
    "cdn",
    "cache",
    "cloudflare",
    "bunnycdn",
    "edge"
  ],
  "tier": "free",
  "version": "1.2.6",
  "views": [
    "np_cdn_bandwidth_by_zone",
    "np_cdn_cache_hit_rate",
    "np_cdn_top_paths"
  ]
}
