{
  "name": "@nself/plugin-media-processing",
  "version": "1.0.0",
  "description": "Media processing and encoding plugin for nself",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nself-media-processing": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-force-exit --import tsx/esm tests/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@fastify/cors": "^8.4.0",
    "@nself/plugin-utils": "file:../../../shared",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "fastify": "^4.24.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.6.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.5",
      "find-my-way": ">=9.7.0",
      "fast-xml-parser": ">=5.10.1"
    }
  }
}
