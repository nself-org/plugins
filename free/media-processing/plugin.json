{
  "author": "nself",
  "category": "media",
  "description": "FFmpeg-based media encoding and processing with HLS streaming support",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "MP_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "MP_FFMPEG_PATH",
      "required": false
    },
    {
      "description": "",
      "name": "MP_FFPROBE_PATH",
      "required": false
    },
    {
      "description": "",
      "name": "MP_OUTPUT_BASE_PATH",
      "required": false
    },
    {
      "description": "",
      "name": "MP_MAX_CONCURRENT_JOBS",
      "required": false
    },
    {
      "description": "",
      "name": "MP_MAX_INPUT_SIZE_GB",
      "required": false
    },
    {
      "description": "",
      "name": "MP_HARDWARE_ACCEL",
      "required": false
    },
    {
      "description": "",
      "name": "MP_API_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "MP_RATE_LIMIT_MAX",
      "required": false
    },
    {
      "description": "",
      "name": "MP_RATE_LIMIT_WINDOW_MS",
      "required": false
    },
    {
      "description": "",
      "name": "MP_PACKAGER",
      "required": false
    },
    {
      "description": "",
      "name": "MP_SHAKA_PACKAGER_PATH",
      "required": false
    },
    {
      "description": "",
      "name": "MP_OUTPUT_FORMATS",
      "required": false
    },
    {
      "description": "",
      "name": "MP_DROP_FOLDER_PATH",
      "required": false
    },
    {
      "description": "",
      "name": "MP_SETTLE_CHECK_SECONDS",
      "required": false
    },
    {
      "description": "",
      "name": "MP_SETTLE_CHECK_INTERVALS",
      "required": false
    },
    {
      "description": "",
      "name": "MP_METADATA_ENRICHMENT_URL",
      "required": false
    },
    {
      "description": "",
      "name": "MP_OBJECT_STORAGE_URL",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "rust",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "media-processing",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache",
      "media"
    ],
    "network": [
      "*"
    ]
  },
  "port": 3850,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/jobs"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/jobs"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/api/v1/jobs/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/jobs/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/jobs/{id}/outputs"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/profiles"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/profiles"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/api/v1/profiles/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/profiles/{id}"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/api/v1/profiles/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/stats"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/uploads"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/uploads/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ready"
    }
  ],
  "schema": "np_media_processing",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3850
  },
  "status": "stable",
  "systemDependencies": {
    "recommended": [
      {
        "custom_install": "curl -L https://github.com/shaka-project/shaka-packager/releases/latest/download/packager-linux-x64 -o /usr/local/bin/packager && chmod +x /usr/local/bin/packager",
        "name": "shaka-packager",
        "verify": "packager --version"
      },
      {
        "custom_install": "pip3 install guessit",
        "name": "guessit",
        "verify": "guessit --version"
      }
    ],
    "required": [
      {
        "apt": "ffmpeg",
        "brew": "ffmpeg",
        "minVersion": "5.0",
        "name": "ffmpeg",
        "verify": "ffmpeg -version"
      },
      {
        "apt": "ffmpeg",
        "brew": "ffmpeg",
        "minVersion": "5.0",
        "name": "ffprobe",
        "verify": "ffprobe -version"
      }
    ]
  },
  "tables": [
    "np_mediap_encoding_profiles",
    "np_mediap_jobs",
    "np_mediap_job_outputs",
    "np_mediap_hls_manifests",
    "np_mediap_subtitles",
    "np_mediap_trickplay",
    "np_mediap_webhook_events",
    "np_mediap_watcher_events",
    "np_mediap_uploads"
  ],
  "tags": [
    "media",
    "video",
    "encoding",
    "ffmpeg",
    "hls",
    "dash",
    "cmaf",
    "streaming",
    "transcoding"
  ],
  "tier": "free",
  "version": "1.2.6",
  "webhooks": [
    "job.analyzing",
    "job.cancelled",
    "job.completed",
    "job.created",
    "job.downloading",
    "job.encoding",
    "job.failed",
    "job.packaging",
    "job.progress",
    "job.qa_failed",
    "job.uploading",
    "watcher.file_detected",
    "watcher.job_submitted"
  ]
}
