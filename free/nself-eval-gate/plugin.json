{
  "author": "nself",
  "binaryName": "nself-eval",
  "category": "development",
  "commands": {
    "binary": "nself-eval",
    "command": "eval",
    "json": "none",
    "output": "document",
    "side_effect": "remote",
    "subcommands": [
      {
        "flags": [
          {
            "name": "tier",
            "required": true,
            "type": "string",
            "usage": "Autonomy tier to check (required): supervised|semi-auto|full-auto"
          },
          {
            "default": "http://localhost:3770",
            "name": "eval-url",
            "type": "string",
            "usage": "nself-eval-gate plugin base URL"
          },
          {
            "default": "primary",
            "name": "source-account",
            "type": "string",
            "usage": "Source account ID header value"
          }
        ],
        "json": "legacy",
        "name": "gate",
        "output": "document",
        "side_effect": "read",
        "summary": "Check whether an autonomy tier gate is cleared"
      }
    ],
    "summary": "Run an eval suite or check an autonomy tier gate via the nself-eval-gate service"
  },
  "description": "Eval harness and autonomy-tier gate for nSelf. Three-mode scoring (exact, semantic via BGE-M3, rubric via LLM-as-judge), recall-quality precision/recall/fact_f1 metrics, CI integration via nself ci eval, and autonomy-tier threshold enforcement.",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "NSELF_EVAL_GATE_DB_URL",
      "required": true
    },
    {
      "description": "",
      "name": "NSELF_EVAL_GATE_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_EVAL_GATE_REDIS_URL",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_EVAL_GATE_JUDGE_MODEL",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_EVAL_GATE_JUDGE_TIMEOUT_S",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_EVAL_GATE_EMBED_TIMEOUT_S",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_EVAL_GATE_MAX_CONCURRENCY",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_EVAL_GATE_CACHE_EMBED_TTL_H",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_EVAL_GATE_CACHE_JUDGE_TTL_H",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_EVAL_RECALL_K",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_EVAL_SCHEMA_VERSION",
      "required": false
    }
  ],
  "health_endpoint": "/health",
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.1.1",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "nself-eval-gate",
  "optionalDependencies": [
    "plugin-retrieval",
    "nself-ai-gateway"
  ],
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [],
    "network": [
      "outbound"
    ]
  },
  "pluginType": "cli",
  "port": 3770,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.1.1"
  },
  "rest_routes": [
    {
      "auth": "plugin-jwt",
      "method": "POST",
      "path": "/eval/run"
    },
    {
      "auth": "plugin-jwt",
      "method": "GET",
      "path": "/eval/runs/{id}"
    },
    {
      "auth": "plugin-jwt",
      "method": "GET",
      "path": "/eval/suites"
    },
    {
      "auth": "plugin-jwt",
      "method": "POST",
      "path": "/eval/validate"
    },
    {
      "auth": "plugin-jwt",
      "method": "GET",
      "path": "/eval/thresholds"
    },
    {
      "auth": "plugin-jwt",
      "method": "GET",
      "path": "/eval/gate/{tier}"
    }
  ],
  "schema": "np_nself_eval_gate",
  "service": {
    "kind": "library",
    "port": 3770
  },
  "status": "stable",
  "tables": [
    "np_eval_suites",
    "np_eval_tasks",
    "np_eval_runs",
    "np_eval_thresholds"
  ],
  "tags": [
    "eval",
    "ci",
    "autonomy-gate",
    "scoring",
    "llm-as-judge"
  ],
  "tier": "free",
  "version": "1.2.6"
}
