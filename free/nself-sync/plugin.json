{
  "name": "nself-sync",
  "author": "nSelf Team",
  "displayName": "Event-Log Sync Engine for ɳClaw",
  "version": "1.1.2",
  "tier": "pro",
  "category": "infrastructure",
  "minNselfVersion": "1.1.1",
  "bundle": [
    "nclaw",
    "shared"
  ],
  "port": 3853,
  "language": "go",
  "env": {
    "required": [
      "DATABASE_URL",
      "NSELF_SYNC_JWT_SECRET"
