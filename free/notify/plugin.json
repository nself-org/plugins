{
  "arch_support": [
    "linux-x86_64",
    "linux-arm64",
    "darwin-arm64"
  ],
  "author": "nself",
  "category": "communication",
  "description": "Multi-channel notification service. Channels: Email (SMTP), Webhook (HMAC-signed). HTTP endpoints for sending notifications, managing templates, and viewing delivery history.",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "PORT",
      "required": false
    },
    {
      "description": "",
      "name": "PLUGIN_INTERNAL_SECRET",
      "required": false
    },
    {
      "description": "",
      "name": "SMTP_HOST",
      "required": false
    },
    {
      "description": "",
      "name": "SMTP_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "SMTP_USER",
      "required": false
    },
    {
      "description": "",
      "name": "SMTP_PASSWORD",
      "required": false
    },
    {
      "description": "",
      "name": "SMTP_FROM",
      "required": false
    },
    {
      "description": "",
      "name": "WEBHOOK_HMAC_SECRET",
      "required": false
    }
  ],
  "health_endpoint": "/health",
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "0.9.9",
  "multiApp": {
    "supported": false
  },
  "name": "notify",
  "permissions": {
    "database": [
      "create",
      "read",
      "update"
    ],
    "filesystem": [],
    "network": [
      "outbound"
    ]
  },
  "port": 3052,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=0.9.9"
  },
  "schema": "np_notify",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3052
  },
  "status": "stable",
  "tables": [
    "np_notify_notifications",
    "np_notify_templates"
  ],
  "tags": [
