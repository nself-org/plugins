{
  "author": "nself",
  "category": "infrastructure",
  "description": "Admin API service providing aggregated metrics, system health, session counts, storage breakdown, and real-time dashboard endpoints",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "ADMIN_API_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "PROMETHEUS_URL",
      "required": false
    },
    {
      "description": "",
      "name": "ADMIN_API_CACHE_TTL",
      "required": false
    },
    {
      "description": "",
      "name": "ADMIN_API_WS_ENABLED",
      "required": false
    },
    {
      "description": "",
      "name": "ADMIN_API_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "CORS_ALLOWED_ORIGIN",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "admin-api",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache",
      "temp"
    ],
    "network": [
      "*"
    ]
  },
  "port": 3212,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/audit"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/audit"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/dashboard"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/dashboard"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health/services"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/logs"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/metrics"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/metrics/history"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/metrics/snapshot"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ready"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/stats"
    }
  ],
  "schema": "np_admin_api",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3212
  },
  "status": "stable",
  "tables": [
    "np_admin_metrics_snapshots",
    "np_admin_dashboard_config"
  ],
  "tags": [
    "admin",
    "dashboard",
    "metrics",
    "monitoring",
    "system-health"
  ],
  "tier": "free",
  "version": "1.2.6"
}
