{
  "arch_support": [
    "linux-x86_64",
    "linux-arm64",
    "darwin-arm64"
  ],
  "author": "nself",
  "category": "compliance",
  "description": "Advanced audit analytics over np_audit_log: anomaly detection (z-score baseline), user behaviour heatmaps, privileged-action review queue, and webhook/email alerts.",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "NSELF_AUDIT_ANALYTICS",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_AUDIT_ANALYTICS_REALTIME",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_AUDIT_ANOMALY_ZSCORE",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_AUDIT_HEATMAP_REFRESH",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_AUDIT_PRIVILEGED_REVIEW_TTL",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_AUDIT_ALERT_WEBHOOK",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_AUDIT_ALERT_EMAIL",
      "required": false
    },
    {
      "description": "",
      "name": "AUDIT_ANALYTICS_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "AUDIT_ANALYTICS_HOST",
      "required": false
    },
    {
      "description": "",
      "name": "AUDIT_ANALYTICS_LOG_LEVEL",
      "required": false
    }
  ],
  "health_endpoint": "/health",
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.9",
  "multiApp": {
    "isolationColumn": "tenant_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "audit-analytics",
  "permissions": {
    "database": [
      "create",
      "read",
      "update"
    ],
    "filesystem": [
      "logs"
    ],
    "network": [
      "webhook"
    ]
  },
  "port": 3218,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.9",
    "plugins": [
      "audit-log"
    ]
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/audit/analytics/anomalies"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/audit/analytics/anomalies/{id}"
    },
    {
      "auth": "bearer",
      "method": "PATCH",
      "path": "/audit/analytics/anomalies/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/audit/analytics/heatmap"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/audit/analytics/top-actors"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/audit/privileged-reviews"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/audit/privileged-reviews/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/audit/privileged-reviews/overdue"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/audit/analytics/refresh"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/audit/analytics/status"
    }
  ],
  "schema": "np_audit_analytics",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3218
  },
  "status": "stable",
  "tables": [
    "np_audit_anomalies",
    "np_audit_privileged_reviews"
  ],
  "tags": [
    "audit",
    "analytics",
    "anomaly",
    "security",
    "compliance",
    "soc2",
    "pci",
    "hipaa",
    "iso27001"
  ],
  "tier": "free",
  "version": "1.2.13",
  "webhooks": [
    "anomaly.detected",
    "anomaly.reviewed",
    "privileged_review.overdue"
  ]
}
