{
  "author": "nself",
  "category": "automation",
  "description": "Automation engine providing trigger-action workflow chains, conditional logic, scheduled tasks, webhook integrations, and cross-plugin orchestration",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "WORKFLOWS_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "WORKFLOWS_DEFAULT_TIMEOUT",
      "required": false
    },
    {
      "description": "",
      "name": "WORKFLOWS_MAX_CONCURRENT",
      "required": false
    },
    {
      "description": "",
      "name": "WORKFLOWS_WORKER_POOL_SIZE",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "workflows",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache"
    ],
    "network": [
      "*"
    ]
  },
  "port": 3733,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ready"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/webhooks/{token}"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/{id}/cancel"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/{id}/duplicate"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/{id}/execute"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{id}/executions"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/{id}/publish"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{id}/steps"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/{id}/test"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/{id}/unpublish"
    }
  ],
  "schema": "np_workflows",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3733
  },
  "status": "stable",
  "tables": [
    "np_workflows_workflows",
    "np_workflows_executions",
    "np_workflows_execution_steps",
    "np_workflows_triggers",
    "np_workflows_actions",
    "np_workflows_templates",
    "np_workflows_variables",
    "np_workflows_webhook_logs",
    "np_workflows_approvals"
  ],
  "tags": [
    "workflows",
    "automation",
    "triggers",
    "actions",
    "scheduling",
    "webhooks",
    "orchestration"
  ],
  "tier": "free",
  "version": "1.2.13",
  "webhooks": [
    "approval.required",
    "approval.responded",
    "execution.completed",
    "execution.failed",
    "execution.started",
    "execution.timeout",
    "trigger.fired",
    "workflow.archived",
    "workflow.created",
    "workflow.published"
  ]
}
