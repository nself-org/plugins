# =============================================================================
# GitHub Actions Runner Plugin — Environment Variables
# =============================================================================

# ----------------------------------------------------------------
# REQUIRED
# ----------------------------------------------------------------

# Recommended: a fine-grained token for the organisation with the
# "Self-hosted runners: write" permission (and "Administration: write" on the
# repository for repo scope). Create at: https://github.com/settings/personal-access-tokens
# A classic token also works: admin:org (org-level runner) or repo (repo-level).
# The token is used to read the runner group before every registration/start.
GITHUB_RUNNER_PAT=replace-with-your-token

# GitHub organization name
GITHUB_RUNNER_ORG=my-org

# ----------------------------------------------------------------
# OPTIONAL
# ----------------------------------------------------------------

# Runner name (shown in GitHub settings)
# Defaults to: <hostname>-nself
# GITHUB_RUNNER_NAME=my-server-nself

# Runner labels (comma-separated)
# IMPORTANT: Include ubuntu-latest so existing CI workflows work without changes
# Default: self-hosted,linux,x64,ubuntu-latest
# GITHUB_RUNNER_LABELS=self-hosted,linux,x64,ubuntu-latest

# Runner scope: org (registers for all org repos) or repo (single repo)
# Default: org
# GITHUB_RUNNER_SCOPE=org

# Repository name (only required when GITHUB_RUNNER_SCOPE=repo)
# GITHUB_RUNNER_REPO=my-repo-name

# Runner group (leave blank to use the organisation's default group).
# A group open to public repositories is refused (error runner_group_public).
# GITHUB_RUNNER_GROUP=

# UNSAFE. Let a runner group or repository that is open to public repositories
# register and start. Fork pull requests of public repositories can then run
# arbitrary code on this host. A warning is logged on every start.
# Default: false
# GITHUB_RUNNER_ALLOW_PUBLIC_REPOS=false

# Pin a specific runner version (default: auto-detect latest)
# Find versions: https://github.com/actions/runner/releases
# GITHUB_RUNNER_VERSION=2.321.0
