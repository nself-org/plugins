{
  "author": "nself",
  "category": "development",
  "description": "GitHub Actions self-hosted runner. Registers with your GitHub org and picks up CI jobs tagged `runs-on: ubuntu-latest` — enabling private repos to run CI without GitHub-hosted runners.",
  "entryPoint": "cmd/main.go",
  "envVars": [
    {
      "description": "",
      "name": "GITHUB_RUNNER_PAT",
      "required": true
    },
    {
      "description": "",
      "name": "GITHUB_RUNNER_ORG",
      "required": true
    },
    {
      "description": "",
      "name": "GITHUB_RUNNER_NAME",
      "required": false
    },
    {
      "description": "",
      "name": "GITHUB_RUNNER_LABELS",
      "required": false
    },
    {
      "description": "",
      "name": "GITHUB_RUNNER_SCOPE",
      "required": false
    },
    {
      "description": "",
      "name": "GITHUB_RUNNER_REPO",
      "required": false
    },
    {
      "description": "",
      "name": "GITHUB_RUNNER_GROUP",
      "required": false
    },
    {
      "description": "",
      "name": "GITHUB_RUNNER_VERSION",
      "required": false
    }
  ],
  "homepage": "https://github.com/nself-org/plugins/tree/main/plugins/github-runner",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "isolationColumn": "source_account_id",
    "supported": false
  },
  "name": "github-runner",
  "permissions": {
    "database": [],
    "filesystem": [
      "logs",
      "runners"
    ],
    "network": [
      "github.com",
      "*.actions.githubusercontent.com"
    ]
  },
  "port": 3054,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3054
  },
  "status": "stable",
  "tags": [
    "github",
    "ci",
    "cd",
    "actions",
    "runner",
    "self-hosted",
    "devops"
  ],
  "tier": "free",
  "version": "1.2.6"
}
