{
  "author": "nself",
  "category": "commerce",
  "description": "PayPal payment data sync with webhook handling",
  "entryPoint": "nself-paypal",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "PAYPAL_CLIENT_ID",
      "required": true
    },
    {
      "description": "",
      "name": "PAYPAL_CLIENT_SECRET",
      "required": true
    },
    {
      "description": "",
      "name": "PAYPAL_CLIENT_IDS",
      "required": false
    },
    {
      "description": "",
      "name": "PAYPAL_CLIENT_SECRETS",
      "required": false
    },
    {
      "description": "",
      "name": "PAYPAL_ACCOUNT_LABELS",
      "required": false
    },
    {
      "description": "",
      "name": "PAYPAL_WEBHOOK_IDS",
      "required": false
    },
    {
      "description": "",
      "name": "PAYPAL_WEBHOOK_SECRETS",
      "required": false
    },
    {
      "description": "",
      "name": "PAYPAL_ENVIRONMENT",
      "required": false
    },
    {
      "description": "",
      "name": "PAYPAL_SYNC_INTERVAL",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "paypal",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache"
    ],
    "network": [
      "paypal.com",
      "api-m.paypal.com",
      "api-m.sandbox.paypal.com"
    ]
  },
  "port": 3071,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "schema": "np_paypal",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3071
  },
  "status": "stable",
  "tables": [
    "np_paypal_transactions",
    "np_paypal_orders",
    "np_paypal_captures",
    "np_paypal_authorizations",
    "np_paypal_refunds",
    "np_paypal_subscriptions",
    "np_paypal_subscription_plans",
    "np_paypal_products",
    "np_paypal_disputes",
    "np_paypal_payouts",
    "np_paypal_invoices",
    "np_paypal_payers",
    "np_paypal_balances",
    "np_paypal_webhook_events"
  ],
  "tags": [
    "payments",
    "donations",
    "subscriptions",
    "paypal",
    "webhooks"
  ],
  "tier": "free",
  "version": "1.2.6",
  "webhooks": [
    "BILLING.SUBSCRIPTION.ACTIVATED",
    "BILLING.SUBSCRIPTION.CANCELLED",
    "BILLING.SUBSCRIPTION.CREATED",
    "BILLING.SUBSCRIPTION.EXPIRED",
    "BILLING.SUBSCRIPTION.SUSPENDED",
    "BILLING.SUBSCRIPTION.UPDATED",
    "CHECKOUT.ORDER.APPROVED",
    "CHECKOUT.ORDER.COMPLETED",
    "CHECKOUT.ORDER.VOIDED",
    "CUSTOMER.DISPUTE.CREATED",
    "CUSTOMER.DISPUTE.OTHER",
    "CUSTOMER.DISPUTE.RESOLVED",
    "CUSTOMER.DISPUTE.UPDATED",
    "INVOICING.INVOICE.CANCELLED",
    "INVOICING.INVOICE.PAID",
    "PAYMENT.CAPTURE.COMPLETED",
    "PAYMENT.CAPTURE.DENIED",
    "PAYMENT.CAPTURE.PENDING",
    "PAYMENT.CAPTURE.REFUNDED",
    "PAYMENT.CAPTURE.REVERSED",
    "PAYMENT.PAYOUTSBATCH.DENIED",
    "PAYMENT.PAYOUTSBATCH.PROCESSING",
    "PAYMENT.PAYOUTSBATCH.SUCCESS",
    "PAYMENT.SALE.COMPLETED",
    "PAYMENT.SALE.REFUNDED"
  ]
}
