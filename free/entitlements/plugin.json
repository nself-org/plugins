{
  "author": "nself",
  "category": "commerce",
  "description": "Feature gating, subscription plan management, usage quota tracking, and metered billing",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "ENTITLEMENTS_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "ENTITLEMENTS_DEFAULT_CURRENCY",
      "required": false
    },
    {
      "description": "",
      "name": "ENTITLEMENTS_DEFAULT_TRIAL_DAYS",
      "required": false
    },
    {
      "description": "",
      "name": "ENTITLEMENTS_API_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "ENTITLEMENTS_RATE_LIMIT_MAX",
      "required": false
    },
    {
      "description": "",
      "name": "ENTITLEMENTS_RATE_LIMIT_WINDOW_MS",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "entitlements",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs"
    ],
    "network": []
  },
  "port": 3735,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/check"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/usage"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/usage/track"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ready"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/v1/status"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/{id}/cancel"
    },
    {
      "auth": "bearer",
      "method": "PATCH",
      "path": "/api/v1/subscriptions/{id}/pause"
    },
    {
      "auth": "bearer",
      "method": "PATCH",
      "path": "/api/v1/subscriptions/{id}/resume"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/subscriptions/{id}/proration"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/subscriptions/{id}/upgrade"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/grants"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/grants"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/api/v1/grants/{id}"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/check/batch"
    }
  ],
  "schema": "public",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3735
  },
  "status": "stable",
  "tables": [
    "entitlement_grants"
  ],
  "tags": [
    "entitlements",
    "subscriptions",
    "plans",
    "quotas",
    "billing",
    "feature-gating"
  ],
  "tier": "free",
  "version": "1.2.6",
  "webhooks": [
    "addon.added",
    "addon.removed",
    "grant.created",
    "grant.revoked",
    "plan.downgraded",
    "plan.upgraded",
    "quota.exceeded",
    "quota.reset",
    "subscription.canceled",
    "subscription.created",
    "subscription.renewed",
    "subscription.updated",
    "trial.ended",
    "trial.started"
  ]
}
