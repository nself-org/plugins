{
  "author": "nself",
  "category": "integrations",
  "description": "Forward and reverse geocoding with provider-agnostic caching layer. Nominatim (free, OSM) is the default; Google Places and Mapbox are premium fallbacks. Exposes geocodeAddress, reverseGeocode, geocodeBatch, clearGeoCache via Hasura Remote Schema.",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "GEOCODING_CACHE_ENABLED",
      "required": false
    },
    {
      "description": "",
      "name": "GEOCODING_CACHE_TTL_DAYS",
      "required": false
    },
    {
      "description": "",
      "name": "GEOCODING_GOOGLE_API_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "GEOCODING_MAPBOX_ACCESS_TOKEN",
      "required": false
    },
    {
      "description": "",
      "name": "GEOCODING_MAX_BATCH_SIZE",
      "required": false
    },
    {
      "description": "",
      "name": "GEOCODING_NOMINATIM_EMAIL",
      "required": false
    },
    {
      "description": "",
      "name": "GEOCODING_NOMINATIM_URL",
      "required": false
    },
    {
      "description": "",
      "name": "GEOCODING_PROVIDERS",
      "required": false
    },
    {
      "description": "",
      "name": "GEOCODING_REDIS_URL",
      "required": false
    },
    {
      "description": "",
      "name": "GEO_CACHE_TTL_SECONDS",
      "required": false
    },
    {
      "description": "",
      "name": "GEO_RATE_LIMIT_RPM",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "planned",
  "minNselfVersion": "1.1.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "nself-geo",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs"
    ],
    "network": [
      "*"
    ]
  },
  "port": 3203,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.1.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/geo/forward",
      "summary": "Forward geocode: address to lat/lng"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/geo/reverse",
      "summary": "Reverse geocode: lat/lng to city/state/country"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/geo/batch",
      "summary": "Batch geocode up to 100 addresses"
    },
    {
      "auth": "admin",
      "method": "DELETE",
      "path": "/geo/cache",
      "summary": "Clear stale cache entries (admin only)"
    },
    {
      "auth": "none",
      "method": "GET",
      "path": "/health",
      "summary": "Liveness probe"
    }
  ],
  "schema": "np_nself_geo",
  "service": {
    "kind": "library"
  },
  "status": "planned",
  "tables": [
    "np_geo.forward_cache",
    "np_geo.reverse_cache"
  ],
  "tags": [
    "geocoding",
    "maps",
    "location",
    "nominatim",
    "reverse-geocoding",
    "caching"
  ],
  "tier": "free",
  "version": "1.2.6"
}
