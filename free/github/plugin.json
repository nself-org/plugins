{
  "author": "nself",
  "category": "development",
  "description": "GitHub repository, issue, and workflow integration",
  "entryPoint": "nself-github",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "GITHUB_TOKEN",
      "required": true
    },
    {
      "description": "",
      "name": "GITHUB_WEBHOOK_SECRET",
      "required": false
    },
    {
      "description": "",
      "name": "GITHUB_ORG",
      "required": false
    },
    {
      "description": "",
      "name": "GITHUB_REPOS",
      "required": false
    },
    {
      "description": "",
      "name": "GITHUB_API_KEYS",
      "required": false
    },
    {
      "description": "",
      "name": "GITHUB_ACCOUNT_LABELS",
      "required": false
    }
  ],
  "homepage": "https://github.com/nself-org/plugins/tree/main/plugins/github",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "composite",
    "supported": true
  },
  "name": "github",
  "port": 3002,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "schema": "np_github",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3002
  },
  "status": "stable",
  "tables": [
    "np_github_organizations",
    "np_github_repositories",
    "np_github_branches",
    "np_github_issues",
    "np_github_pull_requests",
    "np_github_pr_reviews",
    "np_github_issue_comments",
    "np_github_pr_review_comments",
    "np_github_commit_comments",
    "np_github_commits",
    "np_github_releases",
    "np_github_tags",
    "np_github_milestones",
    "np_github_labels",
    "np_github_workflows",
    "np_github_workflow_runs",
    "np_github_workflow_jobs",
    "np_github_check_suites",
    "np_github_check_runs",
    "np_github_deployments",
    "np_github_teams",
    "np_github_collaborators",
    "np_github_webhook_events"
  ],
  "tags": [
    "github",
    "git",
    "ci",
    "devops",
    "issues",
    "pull-requests"
  ],
  "tier": "free",
  "version": "1.2.6",
  "webhooks": [
    "create",
    "delete",
    "deployment",
    "deployment_status",
    "fork",
    "issue_comment",
    "issues",
    "pull_request",
    "pull_request_review",
    "push",
    "release",
    "star",
    "workflow_run"
  ]
}
