  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "web3",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs"
    ],
    "network": []
  },
  "port": 3128,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ready"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/{id}"
    }
  ],
  "schema": "np_web3",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3128
  },
  "status": "stable",
  "tables": [
    "np_web3_wallets",
    "np_web3_nfts",
    "np_web3_collections",
    "np_web3_tokens",
    "np_web3_token_balances",
    "np_web3_token_gates",
    "np_web3_gate_checks",
    "np_web3_daos",
    "np_web3_proposals",
    "np_web3_votes",
    "np_web3_transactions",
    "np_web3_events"
  ],
  "tags": [
    "web3",
    "blockchain",
    "nft",
    "token-gating",
    "dao",
    "wallet",
    "ethereum",
    "defi"
  ],
  "tier": "free",
  "version": "1.2.13",
  "webhooks": [
    "collection.indexed",
    "nft.minted",
    "nft.transferred",
    "proposal.created",
    "proposal.executed",
    "token_gate.failed",
    "token_gate.passed",
    "transaction.confirmed",
    "vote.cast",
    "wallet.connected",
    "wallet.verified"
  ]
}
