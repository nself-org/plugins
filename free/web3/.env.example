# =============================================================================
# uweb3 Plugin - Environment Configuration
# =============================================================================
# Blockchain integration, NFT support, token-gated access, DAO governance, and decentralized identity
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED - Auto-provided by nself CLI
# -----------------------------------------------------------------------------

# PostgreSQL connection string (auto-provided by nself)
DATABASE_URL=postgresql://postgres:password@localhost:5432/nself_db

# -----------------------------------------------------------------------------
# REQUIRED - Security Configuration (auto-provided by nself)
# -----------------------------------------------------------------------------

# API key for inter-plugin authentication
WEB3_API_KEY=your-api-key-here

# Rate limiting (requests per window)
WEB3_RATE_LIMIT_MAX=100

# Rate limiting window (milliseconds)
WEB3_RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# OPTIONAL - Server Configuration
# -----------------------------------------------------------------------------

# Server port (default from plugin.json: 3112)
WEB3_PORT=3112

# Log level: debug, info, warn, error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# OPTIONAL - Plugin-Specific Configuration
# -----------------------------------------------------------------------------

# WEB3_DEFAULT_CHAIN_ID
WEB3_DEFAULT_CHAIN_ID=value

# WEB3_SUPPORTED_CHAINS
WEB3_SUPPORTED_CHAINS=value

# WEB3_GATE_CHECK_CACHE_TTL
WEB3_GATE_CHECK_CACHE_TTL=value

# Chain RPC node URLs (server-side only — never NEXT_PUBLIC_*)
# Add one per chain ID you want to support. chainId matches EVM standard IDs.
# WEB3_RPC_URL_1=https://mainnet.infura.io/v3/YOUR_KEY
# WEB3_RPC_URL_10=https://optimism.infura.io/v3/YOUR_KEY
# WEB3_RPC_URL_137=https://polygon.infura.io/v3/YOUR_KEY
# WEB3_RPC_URL_8453=https://base.infura.io/v3/YOUR_KEY
# WEB3_RPC_URL_42161=https://arbitrum.infura.io/v3/YOUR_KEY
# WEB3_RPC_URL_11155111=https://sepolia.infura.io/v3/YOUR_KEY


# -----------------------------------------------------------------------------
# Additional Configuration
# -----------------------------------------------------------------------------
#
# For complete plugin documentation and configuration options, see:
# - Plugin README: plugins/${PLUGIN_NAME}/README.md
# - Plugin JSON: plugins/${PLUGIN_NAME}/plugin.json
# - nself documentation: https://github.com/acamarata/nself-plugins
#
# Note: All variables marked as REQUIRED are auto-provided by the nself CLI
# during plugin installation and do not need manual configuration.
# -----------------------------------------------------------------------------
