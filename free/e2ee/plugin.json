{
  "author": "nself",
  "category": "authentication",
  "description": "End-to-end encryption key directory: X3DH prekey distribution + Kyber-1024 (ML-KEM-1024) post-quantum prekeys for nchat. Server stores PUBLIC keys only; private keys never leave the client.",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "E2EE_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "E2EE_PLUGIN_HOST",
      "required": false
    },
    {
      "description": "",
      "name": "E2EE_LOG_LEVEL",
      "required": false
    },
    {
      "description": "",
      "name": "E2EE_MAX_ONE_TIME_PREKEYS",
      "required": false
    },
    {
      "description": "",
      "name": "E2EE_MAX_KYBER_PREKEYS",
      "required": false
    }
  ],
  "homepage": "https://github.com/nself-org/plugins/tree/main/plugins/free/e2ee",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "e2ee",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [],
    "network": []
  },
  "port": 3055,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "runtime": "go",
  "schema": "np_e2ee",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3055
  },
  "status": "stable",
  "tables": [
    "np_e2ee_identity_keys",
    "np_e2ee_signed_prekeys",
    "np_e2ee_one_time_prekeys",
    "np_e2ee_kyber_prekeys",
    "np_e2ee_prekey_bundles_served",
    "np_e2ee_verification_states",
    "np_e2ee_safety_numbers",
    "np_e2ee_audit_log"
  ],
  "tags": [
    "e2ee",
    "encryption",
    "kyber",
    "ml-kem",
    "post-quantum",
    "x3dh",
    "prekeys",
    "key-directory",
    "security"
  ],
  "tier": "free",
  "version": "1.2.13"
}
