{
  "name": "analytics",
  "version": "1.1.2",
  "api_version": "1.0.0",
  "description": "Event tracking, counters, funnels, and quota management analytics engine",
  "author": "nself",
  "license": "MIT",
  "isCommercial": false,
  "licenseType": "free",
  "requiredEntitlements": [],
  "requires_license": false,
  "homepage": "https://nself.org/plugins",
  "repository": "https://github.com/nself-org/plugins-pro",
  "minNselfVersion": "1.0.0",
  "port": 3206,
  "category": "infrastructure",
  "tags": [
    "analytics",
    "events",
    "metrics",
    "funnels",
    "quotas"
  ],
  "tables": [
    "np_analytics_events",
    "np_analytics_counters",
    "np_analytics_funnels",
    "np_analytics_quotas",
    "np_analytics_quota_violations",
    "np_analytics_webhook_events"
  ],
  "webhooks": {
    "event.tracked": "New event tracked",
    "counter.incremented": "Counter incremented",
    "quota.exceeded": "Quota limit exceeded",
    "funnel.completed": "Funnel completed",
    "rollup.completed": "Counter rollup completed"
  },
  "actions": {
    "track": "Track an event",
    "counters": "Manage counters",
    "funnels": "Analyze funnels",
    "quotas": "Check quotas",
    "rollup": "Trigger counter rollup",
    "dashboard": "View analytics dashboard"
  },
  "envVars": {
    "required": [
      "DATABASE_URL"
    ],
    "optional": [
      "ANALYTICS_PLUGIN_PORT",
      "ANALYTICS_BATCH_SIZE",
      "ANALYTICS_ROLLUP_INTERVAL_MS",
      "ANALYTICS_EVENT_RETENTION_DAYS",
      "ANALYTICS_COUNTER_RETENTION_DAYS",
      "ANALYTICS_API_KEY",
      "ANALYTICS_RATE_LIMIT_MAX",
      "ANALYTICS_RATE_LIMIT_WINDOW_MS"
    ]
  },
  "config": {
    "batchSize": 100,
    "rollupIntervalMs": 3600000,
    "eventRetentionDays": 90,
    "counterRetentionDays": 365
  },
  "hooks": {
    "postInstall": null,
    "preUninstall": null,
    "postSync": null
  },
  "multiApp": {
    "supported": true,
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "defaultValue": "primary"
  },
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "network": [],
    "filesystem": [
      "logs"
    ]
  },
  "status": "stable",
  "tier": "free",
  "language": "go",
  "entryPoint": "binary",
  "routes": [
    {
      "method": "GET",
      "path": "/api/v1/counters",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/api/v1/counters/increment",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/api/v1/counters/{key}",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/api/v1/events",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/api/v1/events",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/api/v1/events/batch",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/api/v1/funnels",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/api/v1/funnels",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/api/v1/funnels/{id}/analyze",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/api/v1/quotas",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/api/v1/quotas",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/api/v1/stats",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/api/v1/stats/timeseries",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/api/v1/violations",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/health",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/ready",
      "auth": "bearer"
    }
  ],
  "dependencies": {
    "required": [],
    "optional": []
  },
  "entry": "cmd/main.go",
  "checksum": "62146b7a320fbc2228c13f5a52cb06455c9d0a74d5e06a5d28d2ca7cf8083079",
  "bundles": [
    "clawde",
    "nsentry"
  ]
}
