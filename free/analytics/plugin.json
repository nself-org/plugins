{
  "author": "nself",
  "category": "infrastructure",
  "description": "Event tracking, counters, funnels, and quota management analytics engine",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "ANALYTICS_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "ANALYTICS_BATCH_SIZE",
      "required": false
    },
    {
      "description": "",
      "name": "ANALYTICS_ROLLUP_INTERVAL_MS",
      "required": false
    },
    {
      "description": "",
      "name": "ANALYTICS_EVENT_RETENTION_DAYS",
      "required": false
    },
    {
      "description": "",
      "name": "ANALYTICS_COUNTER_RETENTION_DAYS",
      "required": false
    },
    {
      "description": "",
      "name": "ANALYTICS_API_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "ANALYTICS_RATE_LIMIT_MAX",
      "required": false
    },
    {
      "description": "",
      "name": "ANALYTICS_RATE_LIMIT_WINDOW_MS",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "analytics",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs"
    ],
    "network": []
  },
  "port": 3206,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/counters"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/counters/increment"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/counters/{key}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/events"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/events"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/events/batch"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/funnels"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/funnels"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/funnels/{id}/analyze"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/quotas"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/quotas"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/stats"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/stats/timeseries"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/violations"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ready"
    }
  ],
  "schema": "np_analytics",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3206
  },
  "status": "stable",
  "tables": [
    "np_analytics_events",
    "np_analytics_counters",
    "np_analytics_funnels",
    "np_analytics_quotas",
    "np_analytics_quota_violations",
    "np_analytics_webhook_events"
  ],
  "tags": [
    "analytics",
    "events",
    "metrics",
    "funnels",
    "quotas"
  ],
  "tier": "free",
  "version": "1.2.6",
  "webhooks": [
    "counter.incremented",
    "event.tracked",
    "funnel.completed",
    "quota.exceeded",
    "rollup.completed"
  ]
}
