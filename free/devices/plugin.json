{
  "name": "devices",
  "version": "1.1.2",
  "api_version": "1.0.0",
  "description": "IoT device enrollment, trust management, and command dispatch service.",
  "author": "nself",
  "license": "MIT",
  "isCommercial": false,
  "licenseType": "free",
  "requiredEntitlements": [],
  "requires_license": false,
  "homepage": "https://nself.org/plugins",
  "repository": "https://github.com/nself-org/plugins-pro",
  "minNselfVersion": "1.0.0",
  "port": 3603,
  "category": "streaming",
  "tags": [
    "devices",
    "iot",
    "antbox",
    "enrollment",
    "commands",
    "ingest"
  ],
  "tables": [
    "np_dev_devices",
    "np_dev_commands",
    "np_dev_telemetry",
    "np_dev_ingest_sessions",
    "np_dev_audit_log"
  ],
  "views": [
    "np_dev_devices_by_status",
    "np_dev_command_success_rate",
    "np_dev_ingest_uptime",
    "np_dev_health_trends"
  ],
  "webhooks": {},
  "actions": {
    "init": {
      "description": "Initialize database schema",
      "requiresAuth": true
    },
    "server": {
      "description": "Start API server",
      "requiresAuth": true
    },
    "status": {
      "description": "Show fleet statistics",
      "requiresAuth": true
    },
    "devices list": {
      "description": "List all devices",
      "requiresAuth": true
    },
    "devices enroll": {
      "description": "Start enrollment for device",
      "requiresAuth": true
    },
    "devices revoke": {
      "description": "Revoke device trust",
      "requiresAuth": true
    },
    "devices suspend": {
      "description": "Suspend device",
      "requiresAuth": true
    },
    "commands send": {
      "description": "Send command to device",
      "requiresAuth": true
    },
    "ingest sessions": {
      "description": "List all ingest sessions",
      "requiresAuth": true
    },
    "ingest active": {
      "description": "List active ingest sessions",
      "requiresAuth": true
    },
    "health": {
      "description": "Show device health summary",
      "requiresAuth": true
    },
    "stats": {
      "description": "Show fleet-wide statistics",
      "requiresAuth": true
    }
  },
  "envVars": {
    "required": [
      "DATABASE_URL"
    ],
    "optional": [
      "DEV_ENROLLMENT_TOKEN_TTL",
      "DEV_CHALLENGE_TTL",
      "DEV_HEARTBEAT_INTERVAL",
      "DEV_HEARTBEAT_TIMEOUT",
      "DEV_COMMAND_DEFAULT_TIMEOUT",
      "DEV_COMMAND_MAX_RETRIES",
      "DEV_TELEMETRY_RETENTION_DAYS",
      "DEV_INGEST_HEARTBEAT_INTERVAL",
      "DEV_INGEST_HEARTBEAT_TIMEOUT",
      "DEV_INGEST_RETRY_MAX",
      "DEV_INGEST_RETRY_BACKOFF_BASE",
      "DEV_REALTIME_URL",
      "DEV_RECORDING_URL",
      "DEV_STREAM_GATEWAY_URL",
      "DEV_APP_TV_HEARTBEAT_INTERVAL",
      "DEV_APP_TV_INGEST_HEARTBEAT_INTERVAL",
      "DATABASE_URL",
      "PORT",
      "REDIS_URL"
    ]
  },
  "config": {
    "webhookPath": "/webhooks/nself-devices",
    "retryAttempts": 3,
    "retryDelay": 1000
  },
  "hooks": {
    "postInstall": "install.sh",
    "preUninstall": "uninstall.sh",
    "postSync": null
  },
  "multiApp": {
    "supported": true,
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "defaultValue": "default"
  },
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "network": [
      "*"
    ],
    "filesystem": [
      "logs",
      "cache"
    ]
  },
  "status": "stable",
  "tier": "pro",
  "language": "go",
  "routes": [
    {
      "method": "GET",
      "path": "/audit",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/commands/{id}",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/devices",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/devices",
      "auth": "bearer"
    },
    {
      "method": "DELETE",
      "path": "/devices/{id}",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/devices/{id}",
      "auth": "bearer"
    },
    {
      "method": "PUT",
      "path": "/devices/{id}",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/devices/{id}/commands",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/devices/{id}/commands",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/devices/{id}/telemetry",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/health",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/ingest-sessions",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/ingest-sessions",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/ready",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/stats",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/telemetry",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/telemetry",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/telemetry/batch",
      "auth": "bearer"
    }
  ],
  "dependencies": {
    "required": [],
    "optional": []
  },
  "entry": "cmd/main.go",
  "checksum": "af9f9a7a4a621b0a045397b8d1722e285396e740979f952d5a936ae8c2ccbd06",
  "bundles": [
    "nfamily",
    "clawde"
  ]
}
