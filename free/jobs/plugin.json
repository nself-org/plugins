{
  "author": "nself",
  "category": "infrastructure",
  "description": "PostgreSQL-backed background job queue with priorities, scheduling, retries, and REST API. Simplified Go implementation using database polling instead of Redis/BullMQ.",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "JOBS_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "JOBS_POLL_INTERVAL_MS",
      "required": false
    },
    {
      "description": "",
      "name": "JOBS_RETRY_ATTEMPTS",
      "required": false
    }
  ],
  "homepage": "https://github.com/nself-org/plugins/tree/main/plugins/jobs",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "0.9.9",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "jobs",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs"
    ],
    "network": []
  },
  "port": 3105,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=0.9.9"
  },
  "runtime": "go",
  "schema": "np_jobs",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3105
  },
  "status": "stable",
  "tables": [
    "np_jobs_jobs",
    "np_jobs_queues"
  ],
  "tags": [
    "jobs",
    "queue",
    "background",
    "scheduling",
    "workers",
    "postgresql"
  ],
  "tier": "free",
  "version": "1.2.6"
}
