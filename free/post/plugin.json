{
  "arch_support": [
    "linux-x86_64",
    "linux-arm64",
    "darwin-arm64"
  ],
  "author": "nself",
  "category": "content",
  "description": "Multi-platform content publishing. Publish to WordPress, Ghost, Twitter/X, LinkedIn, Telegram channels, Dev.to, and Hashnode with optional scheduling.",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "POST_INTERNAL_SECRET",
      "required": true
    },
    {
      "description": "",
      "name": "POST_ENCRYPTION_KEY",
      "required": true
    },
    {
      "description": "",
      "name": "PORT",
      "required": false
    },
    {
      "description": "",
      "name": "BIND_ADDRESS",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_PLUGIN_LICENSE_KEY",
      "required": false
    }
  ],
  "health_endpoint": "/health",
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "default",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "post",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [],
    "network": [
      "outbound"
    ]
  },
  "port": 3129,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/post/accounts"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/post/accounts"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/post/accounts/{id}"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/post/publish"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/post/queue"
    }
  ],
  "schema": "np_post",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3129
  },
  "status": "stable",
  "tables": [
    "np_post_accounts",
    "np_post_queue"
  ],
  "tags": [
    "publishing",
    "content",
    "wordpress",
    "ghost",
    "twitter",
    "telegram",
    "devto",
    "hashnode",
    "scheduling"
  ],
  "tier": "free",
  "version": "1.2.6"
}
