# =============================================================================
# nself-post — environment variables
# =============================================================================
# Copy to .env and fill in real values. The server refuses to boot if any of
# the REQUIRED variables are missing.

# -----------------------------------------------------------------------------
# Core (REQUIRED)
# -----------------------------------------------------------------------------

# Postgres connection string. nself's nginx routes to the plugin; the plugin
# talks to Postgres directly. Example:
#   postgres://nself_admin:<pass>@postgres:5432/nself?sslmode=disable
DATABASE_URL=

# Shared secret for the X-Internal-Token header. Other nself services send
# this header when calling /post/* routes. Generate with `openssl rand -hex 32`.
POST_INTERNAL_SECRET=

# AES-256 key used to encrypt publishing credentials at rest in np_post_accounts.
# Provide EITHER 64 hex chars OR 44 base64 chars (both decode to 32 bytes).
# Generate with `openssl rand -hex 32` or `openssl rand -base64 32`.
POST_ENCRYPTION_KEY=

# Service port. Defaults to 3129 when unset.
# PORT=3129

# -----------------------------------------------------------------------------
# Platform defaults (OPTIONAL)
# -----------------------------------------------------------------------------
# These are convenience defaults surfaced by the CLI when creating accounts.
# They are NOT used at runtime by the server — credentials are always read from
# the encrypted per-account row.

# -- WordPress (XML-RPC) ------------------------------------------------------
# Default site root or full xmlrpc.php URL used when the CLI prompts for an
# endpoint. Individual accounts can override this.
# POST_WORDPRESS_DEFAULT_URL=https://example.com

# -- Ghost (Admin API) --------------------------------------------------------
# Default Ghost instance URL.
# POST_GHOST_API_URL=https://example.ghost.io

# Ghost Admin API key in the form "<keyId>:<hexSecret>". Generated in Ghost
# Admin → Integrations → Add custom integration.
# POST_GHOST_ADMIN_KEY=abcdef1234567890abcdef12:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# -----------------------------------------------------------------------------
# Roadmap — platforms not yet implemented
# -----------------------------------------------------------------------------
# Accounts created for these platforms will save successfully but calls to
# /post/publish return HTTP 501 with {"error":"platform_not_implemented"}.
# Follow progress at https://github.com/nself-org/plugins-pro/issues
#
#   twitter / x
#   linkedin
#   mastodon
#   bluesky
#   facebook
#   instagram
#   threads
