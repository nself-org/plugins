{
  "author": "nself",
  "category": "infrastructure",
  "description": "Cloudflare zone, DNS, R2, cache, and analytics management",
  "envVars": [
    {
      "description": "",
      "name": "CF_API_TOKEN",
      "required": true
    },
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "CF_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "CF_PLUGIN_HOST",
      "required": false
    },
    {
      "description": "",
      "name": "CF_LOG_LEVEL",
      "required": false
    },
    {
      "description": "",
      "name": "CF_APP_IDS",
      "required": false
    },
    {
      "description": "",
      "name": "CF_ZONE_IDS",
      "required": false
    },
    {
      "description": "",
      "name": "CF_R2_ACCESS_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "CF_R2_SECRET_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "CF_ACCOUNT_ID",
      "required": false
    },
    {
      "description": "",
      "name": "CF_SYNC_INTERVAL",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "cloudflare",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache"
    ],
    "network": [
      "api.cloudflare.com"
    ]
  },
  "port": 3024,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/analytics"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/cache/purge"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/cache/purge-log"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/dns-records"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/dns-records"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/api/v1/dns-records/{id}"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/api/v1/dns-records/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/r2/buckets"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/r2/buckets"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/api/v1/r2/buckets/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/stats"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/zones"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/zones"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/api/v1/zones/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/zones/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ready"
    }
  ],
  "schema": "np_cloudflare",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3024
  },
  "status": "stable",
  "tables": [
    "np_cf_zones",
    "np_cf_dns_records",
    "np_cf_r2_buckets",
    "np_cf_cache_purge_log",
    "np_cf_analytics",
    "np_cf_webhook_events"
  ],
  "tags": [
    "cloudflare",
    "cdn",
    "dns",
    "r2",
    "cache",
    "analytics"
  ],
  "tier": "free",
  "version": "1.2.6",
  "webhooks": [
    "cf.analytics.synced",
    "cf.cache.purged",
    "cf.dns.created",
    "cf.dns.deleted",
    "cf.dns.updated",
    "cf.r2.bucket.created",
    "cf.zone.synced"
  ]
}
