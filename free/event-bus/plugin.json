{
  "author": "nself",
  "category": "infrastructure",
  "description": "Internal event bus with pub/sub, fan-out delivery, dead-letter queue, and replay for inter-plugin messaging.",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "Listen address, default :8212",
      "name": "LISTEN_ADDR",
      "required": false
    }
  ],
  "health_endpoint": "/health",
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "event-bus",
  "port": 8212,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "none",
      "method": "GET",
      "path": "/health"
    }
  ],
  "schema": "np_event_bus",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 8212
  },
  "status": "stable",
  "tables": [
    "np_event_bus_stats"
  ],
  "tags": [
    "events",
    "pubsub",
    "messaging",
    "bus"
  ],
  "tier": "free",
  "version": "1.2.13"
}
