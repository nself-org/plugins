{
  "apiEndpoints": [
    "GET /api/games/roms",
    "GET /api/games/roms/:id",
    "POST /api/games/roms",
    "PATCH /api/games/roms/:id",
    "DELETE /api/games/roms/:id",
    "POST /api/games/roms/scan",
    "GET /api/games/save-states/:rom_id",
    "POST /api/games/save-states/:rom_id",
    "GET /api/games/save-states/:rom_id/:slot",
    "DELETE /api/games/save-states/:rom_id/:slot",
    "GET /api/games/cores",
    "GET /api/games/cores/:platform",
    "GET /api/games/cores/:core_name/download",
    "POST /api/games/cores/installed",
    "GET /api/games/cores/installed",
    "POST /api/games/sessions/start",
    "POST /api/games/sessions/:session_id/end",
    "GET /api/games/sessions/recent",
    "GET /api/games/controllers",
    "POST /api/games/controllers",
    "DELETE /api/games/controllers/:id",
    "POST /api/games/roms/:id/enrich"
  ],
  "author": "nself",
  "category": "media",
  "description": "Retro gaming ROM library management, emulator core serving, save state synchronization, play sessions, and controller configuration for nself-tv",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "RETRO_GAMING_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "IGDB_CLIENT_ID",
      "required": false
    },
    {
      "description": "",
      "name": "IGDB_CLIENT_SECRET",
      "required": false
    },
    {
      "description": "",
      "name": "MOBYGAMES_API_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "RETRO_GAMING_ROM_PATH_PREFIX",
      "required": false
    },
    {
      "description": "",
      "name": "RETRO_GAMING_SAVE_STATE_PATH_PREFIX",
      "required": false
    },
    {
      "description": "",
      "name": "RETRO_GAMING_CORE_PATH_PREFIX",
      "required": false
    },
    {
      "description": "",
      "name": "RETRO_GAMING_CDN_URL",
      "required": false
    },
    {
      "description": "",
      "name": "RETRO_GAMING_STORAGE_BUCKET",
      "required": false
    },
    {
      "description": "",
      "name": "LOG_LEVEL",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "retro-gaming",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache",
      "temp"
    ],
    "network": [
      "api.igdb.com",
      "id.twitch.tv",
      "api.mobygames.com"
    ]
  },
  "port": 3124,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ready"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/{id}"
    }
  ],
  "schema": "np_retro_gaming",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3124
  },
  "status": "stable",
  "tables": [
    "np_retrogame_roms",
    "np_retrogame_save_states",
    "np_retrogame_play_sessions",
    "np_retrogame_emulator_cores",
    "np_retrogame_controller_configs",
    "np_retrogame_core_installations"
  ],
  "tags": [
    "retro-gaming",
    "roms",
    "emulator",
    "save-states",
    "controller",
    "nself-tv",
    "igdb",
    "libretro"
  ],
  "tier": "free",
  "version": "1.2.6"
}
