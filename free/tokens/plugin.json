{
  "author": "nself",
  "category": "media",
  "description": "Secure content delivery tokens, HLS encryption key management, and entitlement checks",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "TOKENS_ENCRYPTION_KEY",
      "required": true
    },
    {
      "description": "",
      "name": "TOKENS_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "TOKENS_APP_IDS",
      "required": false
    },
    {
      "description": "",
      "name": "TOKENS_DEFAULT_TTL_SECONDS",
      "required": false
    },
    {
      "description": "",
      "name": "TOKENS_HLS_ENCRYPTION_ENABLED",
      "required": false
    },
    {
      "description": "",
      "name": "TOKENS_DEFAULT_ENTITLEMENT_CHECK",
      "required": false
    },
    {
      "description": "",
      "name": "TOKENS_ALLOW_ALL_IF_NO_ENTITLEMENTS",
      "required": false
    }
  ],
  "homepage": "https://github.com/nself-org/plugins/tree/main/plugins/tokens",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "tokens",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs"
    ],
    "network": []
  },
  "port": 3107,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "runtime": "go",
  "schema": "np_tokens",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3107
  },
  "status": "stable",
  "tables": [
    "np_tokens_signing_keys",
    "np_tokens_issued",
    "np_tokens_encryption_keys",
    "np_tokens_entitlements",
    "np_tokens_webhook_events"
  ],
  "tags": [
    "tokens",
    "signed-urls",
    "encryption",
    "hls",
    "drm",
    "entitlement",
    "access-control"
  ],
  "tier": "free",
  "version": "1.2.6"
}
