{
  "author": "nself",
  "category": "infrastructure",
  "description": "mDNS/Bonjour service discovery for zero-config LAN advertising",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "MDNS_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "MDNS_SERVICE_TYPE",
      "required": false
    },
    {
      "description": "",
      "name": "MDNS_INSTANCE_NAME",
      "required": false
    },
    {
      "description": "",
      "name": "MDNS_DOMAIN",
      "required": false
    }
  ],
  "homepage": "https://github.com/nself-org/plugins/tree/main/plugins/mdns",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "mdns",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache",
      "temp"
    ],
    "network": [
      "*"
    ]
  },
  "port": 3216,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "schema": "np_mdns",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3216
  },
  "status": "stable",
  "tables": [
    "np_mdns_services",
    "np_mdns_discovery_log"
  ],
  "tags": [
    "mdns",
    "bonjour",
    "zeroconf",
    "lan",
    "service-discovery"
  ],
  "tier": "free",
  "version": "1.2.6"
}
