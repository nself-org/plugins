{
  "arch_support": [
    "linux-x86_64",
    "linux-arm64",
    "darwin-arm64"
  ],
  "author": "nself",
  "capabilities": [
    "ocsf_normalization",
    "multi_destination",
    "buffered_shipping",
    "resilient_retry"
  ],
  "category": "infrastructure",
  "description": "Forward nSelf audit logs and security events to external SIEM platforms: Datadog, Splunk HEC, Elastic, Loki, and custom webhooks. OCSF/ECS schema normalization.",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "NSELF_SIEM",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_SIEM_HF",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_SIEM_DEFAULT_SCHEMA",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_SIEM_BATCH_SIZE",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_SIEM_FLUSH_INTERVAL",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_SIEM_LOKI_URL",
      "required": false
    },
    {
      "description": "",
      "name": "SIEM_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "LOG_LEVEL",
      "required": false
    }
  ],
  "health_endpoint": "/health",
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.9",
  "multiApp": {
    "isolationColumn": "tenant_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "siem",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs"
    ],
    "network": [
      "datadog",
      "splunk",
      "elastic",
      "loki",
      "webhook"
    ]
  },
  "port": 8002,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.9"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/siem/destinations"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/siem/destinations"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/siem/destinations/{id}"
    },
    {
      "auth": "bearer",
      "method": "PATCH",
      "path": "/siem/destinations/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/siem/destinations/{id}/ship-log"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/siem/destinations/{id}/test"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/siem/flush"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/siem/status"
    }
  ],
  "schema": "np_siem",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 8002
  },
  "status": "stable",
  "tables": [
    "np_siem_destinations",
    "np_siem_ship_log"
  ],
  "tags": [
    "siem",
    "security",
    "audit",
    "datadog",
    "splunk",
    "elastic",
    "loki",
    "ocsf",
    "compliance"
  ],
  "tier": "free",
  "version": "1.2.6"
}
