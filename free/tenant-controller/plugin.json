{
  "arch_support": [
    "linux-x86_64",
    "linux-arm64",
    "darwin-arm64"
  ],
  "author": "nself",
  "capabilities": [
    "multi_project",
    "schema_isolation",
    "hasura_source_per_project",
    "nginx_vhost",
    "jwt_per_project",
    "redis_prefix_isolation",
    "minio_bucket_per_project",
    "prometheus_metrics",
    "otel_tracing",
    "audit_log_q02"
  ],
  "category": "infrastructure",
  "description": "Multi-tenant master controller for nCloud. Manages N isolated nSelf project instances behind a single deploy: per-project Postgres schema, Hasura metadata namespace, Nginx vhost, JWT secret, Redis key prefix, and MinIO bucket. Enables 50 projects on one Hetzner CX21.",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "NSELF_CONTROLLER_ADMIN_TOKEN",
      "required": true
    },
    {
      "description": "",
      "name": "NSELF_CONTROLLER_BASE_DOMAIN",
      "required": true
    },
    {
      "description": "",
      "name": "HASURA_GRAPHQL_ADMIN_SECRET",
      "required": true
    },
    {
      "description": "",
      "name": "HASURA_GRAPHQL_ENDPOINT",
      "required": true
    },
    {
      "description": "",
      "name": "NSELF_CONTROLLER_ENABLED",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_CONTROLLER_MAX_PROJECTS",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_CONTROLLER_DB",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_PROJECT_SCHEMA_PREFIX",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_PROJECT_REDIS_PREFIX",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_PROJECT_HASURA_PORT_START",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_CONTROLLER_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_CONTROLLER_HOST",
      "required": false
    },
    {
      "description": "",
      "name": "REDIS_URL",
      "required": false
    },
    {
      "description": "",
      "name": "MINIO_ENDPOINT",
      "required": false
    },
    {
      "description": "",
      "name": "MINIO_ACCESS_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "MINIO_SECRET_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "NGINX_CONF_PATH",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_AUDIT_RETENTION_DAYS",
      "required": false
    },
    {
      "description": "",
      "name": "OTEL_EXPORTER_OTLP_ENDPOINT",
      "required": false
    },
    {
      "description": "",
      "name": "LOG_LEVEL",
      "required": false
    }
  ],
  "health_endpoint": "/health",
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.9",
  "name": "tenant-controller",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete",
      "ddl"
    ],
    "filesystem": [
      "logs",
      "nginx-conf",
      "controller-db"
    ],
    "network": [
      "hasura-metadata-api",
      "minio",
      "redis"
    ]
  },
  "port": 3750,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.9"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/controller/status"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/projects"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/projects/create"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/projects/{slug}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/projects/{slug}/status"
    }
  ],
  "schema": "np_tenant_controller",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3750
  },
  "status": "stable",
  "tables": [
    "np_tenant_controller.projects",
    "np_tenant_controller.project_audit_log",
    "np_tenant_controller.port_map"
  ],
  "tags": [
    "multi-tenant",
    "cloud",
    "controller",
    "ncloud",
    "isolation",
    "hosting"
  ],
  "tier": "free",
  "version": "1.2.6"
}
