# HIPAA plugin environment variables
# Copy to .env and fill in actual values. Never commit .env.

# Required
DATABASE_URL=postgres://nself:password@localhost:5432/nself_db?sslmode=require

# Feature flags — unused, reserved for future entitlement checks (hipaa is
# free; all endpoints are always enabled regardless of these values)
NSELF_HIPAA=true
NSELF_HIPAA_BAA=false
NSELF_HIPAA_VAULT=false             # Use HashiCorp Vault Transit for tokenization

# Vault Transit (only when NSELF_HIPAA_VAULT=true)
NSELF_HIPAA_VAULT_ADDR=https://vault.example.com
# NSELF_HIPAA_VAULT_TOKEN=<token>   # In .env.secrets — never here

# Retention (default 6 years per HIPAA — never set lower)
NSELF_HIPAA_RETENTION_YEARS=6

# BAA document storage bucket (MinIO)
NSELF_HIPAA_BAA_BUCKET=baa-documents

# Server config
HIPAA_PLUGIN_PORT=3212
HIPAA_PLUGIN_HOST=0.0.0.0
HIPAA_LOG_LEVEL=info

# API key for plugin-to-plugin auth (optional but recommended)
# HIPAA_API_KEY=<strong-random-key>  # In .env.secrets — never here
