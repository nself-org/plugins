{
  "author": "nself",
  "category": "compliance",
  "description": "HIPAA compliance add-on: PHI column registry, PHI access logging with 6-year retention, de-identification helpers (masking + tokenization), encryption-at-rest audit, and BAA workflow.",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "NSELF_HIPAA",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_HIPAA_BAA",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_HIPAA_VAULT",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_HIPAA_VAULT_ADDR",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_HIPAA_VAULT_TOKEN",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_HIPAA_RETENTION_YEARS",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_HIPAA_BAA_BUCKET",
      "required": false
    },
    {
      "description": "",
      "name": "HIPAA_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "HIPAA_PLUGIN_HOST",
      "required": false
    },
    {
      "description": "",
      "name": "HIPAA_API_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "HIPAA_LOG_LEVEL",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "hipaa",
  "permissions": {
    "database": [
      "create",
      "read",
      "update"
    ],
    "filesystem": [
      "logs"
    ],
    "network": []
  },
  "port": 3214,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/audit-log"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/audit-log/export"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/baa"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/baa/activate"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/baa/request"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/baa/terminate"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/deidentify"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/encryption-audit"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/phi-columns"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/phi-columns"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/phi-columns/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ready"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/tokenize"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/tokenize/{token}"
    }
  ],
  "schema": "np_hipaa",
  "service": {
    "kind": "library",
    "port": 3214
  },
  "status": "stable",
  "tables": [
    "np_phi_columns",
    "np_phi_audit_log",
    "np_baa_records"
  ],
  "tags": [
    "hipaa",
    "phi",
    "compliance",
    "healthcare",
    "audit",
    "baa",
    "encryption",
    "deidentify"
  ],
  "tier": "free",
  "version": "1.2.6",
  "webhooks": [
    "baa.requested",
    "baa.signed",
    "baa.terminated",
    "phi.accessed",
    "phi.column.registered",
    "phi.column.unregistered"
  ]
}
