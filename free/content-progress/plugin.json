{
  "author": "nself",
  "category": "media",
  "description": "Track video, audio, and content playback progress with continue watching, watchlists, and favorites",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "PROGRESS_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "PROGRESS_COMPLETE_THRESHOLD",
      "required": false
    },
    {
      "description": "",
      "name": "PROGRESS_HISTORY_SAMPLE_SECONDS",
      "required": false
    },
    {
      "description": "",
      "name": "PROGRESS_HISTORY_RETENTION_DAYS",
      "required": false
    },
    {
      "description": "",
      "name": "PROGRESS_API_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "PROGRESS_RATE_LIMIT_MAX",
      "required": false
    },
    {
      "description": "",
      "name": "PROGRESS_RATE_LIMIT_WINDOW_MS",
      "required": false
    }
  ],
  "homepage": "https://github.com/nself-org/plugins/tree/main/plugins/content-progress",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "content-progress",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs"
    ],
    "network": []
  },
  "port": 3003,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "runtime": "go",
  "schema": "np_content_progress",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3003
  },
  "status": "stable",
  "tables": [
    "np_progress_positions",
    "np_progress_history",
    "np_progress_watchlists",
    "np_progress_favorites",
    "np_progress_webhook_events"
  ],
  "tags": [
    "media",
    "video",
    "audio",
    "progress",
    "watchlist",
    "favorites"
  ],
  "tier": "free",
  "version": "1.2.13",
  "webhooks": [
    "favorite.added",
    "favorite.removed",
    "progress.completed",
    "progress.updated",
    "watchlist.added",
    "watchlist.removed"
  ]
}
