{
  "arch_support": [
    "linux-x86_64",
    "linux-arm64",
    "darwin-arm64"
  ],
  "author": "nself",
  "category": "infrastructure",
  "description": "Full-text search engine with PostgreSQL FTS and MeiliSearch support",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "SEARCH_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "SEARCH_ENGINE",
      "required": false
    },
    {
      "description": "",
      "name": "SEARCH_MEILISEARCH_URL",
      "required": false
    },
    {
      "description": "",
      "name": "SEARCH_MEILISEARCH_API_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "SEARCH_DEFAULT_LIMIT",
      "required": false
    },
    {
      "description": "",
      "name": "SEARCH_MAX_RESULTS",
      "required": false
    },
    {
      "description": "",
      "name": "SEARCH_REINDEX_BATCH_SIZE",
      "required": false
    },
    {
      "description": "",
      "name": "SEARCH_ANALYTICS_ENABLED",
      "required": false
    },
    {
      "description": "",
      "name": "SEARCH_ANALYTICS_RETENTION_DAYS",
      "required": false
    },
    {
      "description": "",
      "name": "SEARCH_API_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "SEARCH_RATE_LIMIT_MAX",
      "required": false
    },
    {
      "description": "",
      "name": "SEARCH_RATE_LIMIT_WINDOW_MS",
      "required": false
    }
  ],
  "health_endpoint": "/health",
  "homepage": "https://github.com/nself-org/plugins/tree/main/plugins/search",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "0.9.9",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "search",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache"
    ],
    "network": [
      "meilisearch"
    ]
  },
  "port": 3302,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=0.9.9"
  },
  "schema": "np_search",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3302
  },
  "status": "stable",
  "tables": [
    "np_search_indexes",
    "np_search_documents"
  ],
  "tags": [
    "search",
    "fts",
    "full-text",
    "postgres",
    "meilisearch",
    "autocomplete"
  ],
  "tier": "free",
  "version": "1.2.13",
  "webhooks": [
    "document.deleted",
    "document.indexed",
    "document.updated",
    "index.created",
    "index.deleted",
    "index.updated"
  ]
}
