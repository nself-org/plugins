{
  "arch_support": [
    "linux-x86_64",
    "linux-arm64",
    "darwin-arm64",
    "darwin-x86_64",
    "windows-x86_64"
  ],
  "author": "nSelf Team",
  "capabilities": [
    "resize",
    "crop",
    "format_convert_webp",
    "format_convert_avif",
    "format_convert_jpeg",
    "format_convert_png",
    "strip_exif",
    "minio_roundtrip"
  ],
  "category": "media",
  "dependencies": [
    "minio"
  ],
  "description": "Server-side image processing plugin for nSelf: resize, crop, format conversion (WebP/AVIF/JPEG/PNG), EXIF strip, and MinIO-integrated upload pipeline. Replaces per-app Sharp/Node.js usage across nFamily, nChat, and any consumer app needing image normalization.",
  "envVars": [
    {
      "description": "",
      "name": "IMAGE_PROCESSING_MINIO_ENDPOINT",
      "required": true
    },
    {
      "description": "",
      "name": "IMAGE_PROCESSING_MINIO_ACCESS_KEY",
      "required": true
    },
    {
      "description": "",
      "name": "IMAGE_PROCESSING_MINIO_SECRET_KEY",
      "required": true
    },
    {
      "description": "",
      "name": "IMAGE_PROCESSING_SHARED_SECRET",
      "required": true
    },
    {
      "description": "",
      "name": "IMAGE_PROCESSING_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "IMAGE_PROCESSING_MAX_INPUT_BYTES",
      "required": false
    },
    {
      "description": "",
      "name": "IMAGE_PROCESSING_MAX_CONCURRENT",
      "required": false
    },
    {
      "description": "",
      "name": "IMAGE_AUDIT_ENABLED",
      "required": false
    }
  ],
  "health_endpoint": "/health",
  "homepage": "https://nself.org/plugins/nself-image",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "planned",
  "minNselfVersion": "1.2.0",
  "multiApp": {
    "isolationColumn": "source_account_id",
    "supported": true
  },
  "name": "nself-image",
  "permissions": {
    "database": [
      "create",
      "read"
    ],
    "filesystem": [
      "temp"
    ],
    "network": [
      "minio"
    ]
  },
  "port": 3852,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.2.0"
  },
  "rest_routes": [
    {
      "auth": "hmac",
      "method": "POST",
      "path": "/process"
    },
    {
      "auth": "none",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "none",
      "method": "GET",
      "path": "/metrics"
    }
  ],
  "schema": "np_nself_image",
  "service": {
    "kind": "library",
    "port": 3852
  },
  "status": "planned",
  "tables": [
    "np_image.jobs"
  ],
  "tags": [
    "image",
    "resize",
    "webp",
    "avif",
    "format-conversion",
    "minio",
    "nfamily",
    "avatar",
    "photo"
  ],
  "tier": "free",
  "version": "1.2.13"
}
