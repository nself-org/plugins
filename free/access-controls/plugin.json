{
  "author": "nself",
  "category": "authentication",
  "description": "Role-based and attribute-based access control (RBAC + ABAC) with policy engine",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "ACL_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "ACL_CACHE_TTL_SECONDS",
      "required": false
    },
    {
      "description": "",
      "name": "ACL_MAX_ROLE_DEPTH",
      "required": false
    },
    {
      "description": "",
      "name": "ACL_DEFAULT_DENY",
      "required": false
    },
    {
      "description": "",
      "name": "ACL_API_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "ACL_RATE_LIMIT_MAX",
      "required": false
    },
    {
      "description": "",
      "name": "ACL_RATE_LIMIT_WINDOW_MS",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "access-controls",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache"
    ],
    "network": []
  },
  "port": 3027,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/check"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/permissions"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/permissions"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/permissions/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/permissions/{id}"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/permissions/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/policies"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/policies"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/policies/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/policies/{id}"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/policies/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ready"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/roles"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/roles"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/roles/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/roles/{id}"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/roles/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/roles/{id}/permissions"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/roles/{id}/permissions"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/roles/{id}/permissions/{permission_id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/users/{user_id}/roles"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/users/{user_id}/roles"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/users/{user_id}/roles/{role_id}"
    }
  ],
  "schema": "np_access_controls",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3027
  },
  "status": "stable",
  "tables": [
    "np_acl_roles",
    "np_acl_permissions",
    "np_acl_role_permissions",
    "np_acl_user_roles",
    "np_acl_policies",
    "np_acl_webhook_events"
  ],
  "tags": [
    "access-control",
    "rbac",
    "abac",
    "authorization",
    "policies",
    "permissions"
  ],
  "tier": "free",
  "version": "1.2.6"
}
