{
  "author": "nself",
  "category": "development",
  "description": "Calendar integration and meeting management with room booking, recurring meetings, and availability tracking. External calendar sync (Google/Outlook) planned for future release.",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "MEETINGS_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "GOOGLE_CALENDAR_CLIENT_ID",
      "required": false
    },
    {
      "description": "",
      "name": "GOOGLE_CALENDAR_CLIENT_SECRET",
      "required": false
    },
    {
      "description": "",
      "name": "GOOGLE_CALENDAR_REDIRECT_URI",
      "required": false
    },
    {
      "description": "",
      "name": "OUTLOOK_CALENDAR_CLIENT_ID",
      "required": false
    },
    {
      "description": "",
      "name": "OUTLOOK_CALENDAR_CLIENT_SECRET",
      "required": false
    },
    {
      "description": "",
      "name": "OUTLOOK_CALENDAR_REDIRECT_URI",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "meetings",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache"
    ],
    "network": [
      "*"
    ]
  },
  "port": 3731,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ready"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{calendar_id}/shares"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/{calendar_id}/shares"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/{calendar_id}/shares/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{event_id}/attendees"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/{event_id}/attendees"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/{event_id}/attendees/{id}"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/{event_id}/attendees/{id}/rsvp"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{event_id}/reminders"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/{event_id}/reminders"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/{event_id}/reminders/{id}"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/{id}"
    }
  ],
  "schema": "np_meetings",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3731
  },
  "status": "stable",
  "tables": [
    "np_meetings_events",
    "np_meetings_attendees",
    "np_meetings_rooms",
    "np_meetings_calendars",
    "np_meetings_calendar_shares",
    "np_meetings_external_calendars",
    "np_meetings_templates",
    "np_meetings_reminders",
    "np_meetings_waitlist"
  ],
  "tags": [
    "meetings",
    "calendar",
    "rooms",
    "scheduling",
    "availability",
    "google-calendar",
    "outlook"
  ],
  "tier": "free",
  "version": "1.2.13",
  "webhooks": [
    "event.cancelled",
    "event.created",
    "event.deleted",
    "event.updated",
    "reminder.sent",
    "room.booked",
    "room.released",
    "rsvp.updated",
    "sync.completed"
  ]
}
