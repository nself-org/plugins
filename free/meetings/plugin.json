{
  "name": "meetings",
  "version": "1.0.1",
  "api_version": "1.0.0",
  "description": "Calendar integration and meeting management with room booking, recurring meetings, and availability tracking. External calendar sync (Google/Outlook) planned for future release.",
  "author": "nself",
  "license": "MIT",
  "isCommercial": false,
  "licenseType": "free",
  "requiredEntitlements": [],
  "requires_license": false,
  "homepage": "https://nself.org/plugins",
  "repository": "https://github.com/nself-org/plugins-pro",
  "minNselfVersion": "1.0.0",
  "port": 3731,
  "category": "development",
  "tags": [
    "meetings",
    "calendar",
    "rooms",
    "scheduling",
    "availability",
    "google-calendar",
    "outlook"
  ],
  "tables": [
    "np_meetings_events",
    "np_meetings_attendees",
    "np_meetings_rooms",
    "np_meetings_calendars",
    "np_meetings_calendar_shares",
    "np_meetings_external_calendars",
    "np_meetings_templates",
    "np_meetings_reminders",
    "np_meetings_waitlist"
  ],
  "webhooks": {
    "event.created": "A new meeting event was created",
    "event.updated": "A meeting event was updated",
    "event.cancelled": "A meeting event was cancelled",
    "event.deleted": "A meeting event was deleted",
    "rsvp.updated": "An attendee RSVP was updated",
    "room.booked": "A meeting room was booked",
    "room.released": "A meeting room booking was released",
    "sync.completed": "External calendar sync completed",
    "reminder.sent": "A meeting reminder was sent"
  },
  "actions": {
    "init": "Initialize meetings system",
    "server": "Start meetings server",
    "status": "View system status",
    "events": "Manage events",
    "rooms": "Manage rooms",
    "calendars": "Manage calendars",
    "templates": "Manage meeting templates"
  },
  "envVars": {
    "required": [
      "DATABASE_URL"
    ],
    "optional": [
      "MEETINGS_PLUGIN_PORT",
      "GOOGLE_CALENDAR_CLIENT_ID",
      "GOOGLE_CALENDAR_CLIENT_SECRET",
      "GOOGLE_CALENDAR_REDIRECT_URI",
      "OUTLOOK_CALENDAR_CLIENT_ID",
      "OUTLOOK_CALENDAR_CLIENT_SECRET",
      "OUTLOOK_CALENDAR_REDIRECT_URI"
    ]
  },
  "config": {
    "webhookPath": "/webhooks/meetings",
    "defaultTimezone": "UTC",
    "businessHoursStart": "09:00",
    "businessHoursEnd": "17:00",
    "slotDurationMinutes": 30,
    "defaultBufferMinutes": 15,
    "maxAdvanceBookingDays": 90
  },
  "multiApp": {
    "supported": true,
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "defaultValue": "primary"
  },
  "hooks": {
    "postInstall": "install.sh",
    "preUninstall": "uninstall.sh",
    "postSync": null
  },
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "network": [
      "*"
    ],
    "filesystem": [
      "logs",
      "cache"
    ]
  },
  "env_vars": [
    {
      "name": "DB_POOL_MIN",
      "required": false,
      "description": "Minimum database pool connections to keep alive (default: 2)"
    },
    {
      "name": "DB_POOL_MAX",
      "required": false,
      "description": "Maximum database pool size (default: 10)"
    },
    {
      "name": "DB_POOL_IDLE_TIMEOUT",
      "required": false,
      "description": "Idle connection timeout in milliseconds (default: 30000)"
    }
  ],
  "status": "stable",
  "tier": "free",
  "language": "go",
  "entryPoint": "binary",
  "routes": [
    {
      "method": "GET",
      "path": "/",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/health",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/ready",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/{calendar_id}/shares",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/{calendar_id}/shares",
      "auth": "bearer"
    },
    {
      "method": "DELETE",
      "path": "/{calendar_id}/shares/{id}",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/{event_id}/attendees",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/{event_id}/attendees",
      "auth": "bearer"
    },
    {
      "method": "DELETE",
      "path": "/{event_id}/attendees/{id}",
      "auth": "bearer"
    },
    {
      "method": "PUT",
      "path": "/{event_id}/attendees/{id}/rsvp",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/{event_id}/reminders",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/{event_id}/reminders",
      "auth": "bearer"
    },
    {
      "method": "DELETE",
      "path": "/{event_id}/reminders/{id}",
      "auth": "bearer"
    },
    {
      "method": "DELETE",
      "path": "/{id}",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/{id}",
      "auth": "bearer"
    },
    {
      "method": "PUT",
      "path": "/{id}",
      "auth": "bearer"
    }
  ],
  "dependencies": {
    "required": [],
    "optional": []
  },
  "entry": "cmd/main.go",
  "checksum": "35dc716bb066c7b17238f35d3cd109fac48adba2ddc50a1ed031c9a59e3e7b47",
  "bundles": [
    "nchat",
    "nclaw"
  ]
}
