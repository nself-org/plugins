{
  "arch_support": [
    "linux-x86_64",
    "linux-arm64",
    "darwin-arm64"
  ],
  "author": "nself",
  "capabilities": [
    "local_llm",
    "model_management",
    "gpu_passthrough",
    "provider_registration"
  ],
  "category": "integrations",
  "description": "One-click offline LLM stack. Stands up an Ollama Docker container, auto-pulls gemma-3-4b on first start, and registers as a provider in plugin-ai. All nSelf AI features route through Ollama when NSELF_AI_PROVIDER=ollama. Zero cloud dependency, zero API key, zero usage cost after install. GPU passthrough is optional and localhost-only (port 11434 binds to 127.0.0.1 — never exposed externally).",
  "envVars": [
    {
      "description": "",
      "name": "NSELF_AI_PROVIDER",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_OLLAMA_HOST",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_OLLAMA_DEFAULT_MODEL",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_OLLAMA_AUTO_PULL",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_OLLAMA_GPU",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_OLLAMA_CONTEXT_WINDOW",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_OLLAMA_TIMEOUT_SECONDS",
      "required": false
    },
    {
      "description": "",
      "name": "OLLAMA_ENABLED",
      "required": false
    },
    {
      "description": "",
      "name": "PLUGIN_AI_OLLAMA_MODEL",
      "required": false
    },
    {
      "description": "",
      "name": "PLUGIN_AI_OLLAMA_URL",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins/ollama",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.9",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "ollama",
  "port": 11434,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.9"
  },
  "schema": "np_ollama",
  "service": {
    "kind": "library",
    "port": 11434
  },
  "status": "stable",
  "tables": [
    "np_ollama_model_registry"
  ],
  "tags": [
    "ai",
    "llm",
    "ollama",
    "local",
    "offline",
    "gemma",
    "self-hosted",
    "docker"
  ],
  "tier": "free",
  "version": "1.2.13"
}
