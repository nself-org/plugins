# =============================================================================
# Observability Plugin - Environment Configuration
# =============================================================================
# Unified observability service with health probes, watchdog timers, and service auto-discovery
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED - Auto-provided by nself CLI
# -----------------------------------------------------------------------------

# PostgreSQL connection string (auto-provided by nself)
DATABASE_URL=postgresql://postgres:password@localhost:5432/nself_db

# -----------------------------------------------------------------------------
# OPTIONAL - Server Configuration
# -----------------------------------------------------------------------------

# Server port (default from plugin.json: 3215)
OBSERVABILITY_PLUGIN_PORT=3215

# Log level: debug, info, warn, error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# OPTIONAL - Health Check Configuration
# -----------------------------------------------------------------------------

# Interval between health checks in seconds (default: 30)
OBSERVABILITY_CHECK_INTERVAL=30

# -----------------------------------------------------------------------------
# OPTIONAL - Docker Integration
# -----------------------------------------------------------------------------

# Docker socket path for container monitoring and auto-discovery
# Defaults to /var/run/docker.sock if not set
OBSERVABILITY_DOCKER_SOCKET=/var/run/docker.sock

# -----------------------------------------------------------------------------
# OPTIONAL - Watchdog Configuration
# -----------------------------------------------------------------------------

# Enable the watchdog timer feature (default: false)
# When enabled, services must check in at regular intervals or trigger alerts
OBSERVABILITY_WATCHDOG_ENABLED=false

# -----------------------------------------------------------------------------
# Observability Features
# -----------------------------------------------------------------------------
#
# Health Probes:
#   - HTTP endpoint health checks with configurable intervals
#   - Response time tracking and status history
#   - Automatic service state transitions (healthy/degraded/unhealthy)
#
# Watchdog Timers:
#   - Services register a watchdog with a timeout interval
#   - If the service fails to check in before timeout, alert is triggered
#   - Useful for monitoring background jobs and cron tasks
#
# Service Auto-Discovery:
#   - Detect running Docker containers as services
#   - Register discovered services for health monitoring
#   - Track service lifecycle events
#
# Alerting:
#   - State change notifications when services go unhealthy
#   - Webhook delivery for external alert routing
#   - Alert history stored in database
#
# Use Cases:
#   - Monitor all services in your nself stack
#   - Track health of external API dependencies
#   - Watchdog monitoring for scheduled jobs
#   - Centralized uptime tracking dashboard
# -----------------------------------------------------------------------------
