{
  "author": "nself",
  "category": "infrastructure",
  "description": "Unified observability service with health probes, watchdog timers, service auto-discovery, and systemd integration",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "OBSERVABILITY_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "OBSERVABILITY_CHECK_INTERVAL",
      "required": false
    },
    {
      "description": "",
      "name": "OBSERVABILITY_DOCKER_SOCKET",
      "required": false
    },
    {
      "description": "",
      "name": "OBSERVABILITY_WATCHDOG_ENABLED",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "observability",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache",
      "temp"
    ],
    "network": [
      "*"
    ]
  },
  "port": 3215,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ai/instructions"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/incidents"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/stats"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/config"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/config"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/config/schema"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ready"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/{id}/check"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{id}/history"
    }
  ],
  "schema": "np_observability",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3215
  },
  "status": "stable",
  "tables": [
    "np_observability_services",
    "np_observability_health_history",
    "np_observability_watchdog_events"
  ],
  "tags": [
    "observability",
    "health-checks",
    "watchdog",
    "service-discovery",
    "monitoring"
  ],
  "tier": "free",
  "version": "1.2.13"
}
