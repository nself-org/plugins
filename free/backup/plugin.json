{
  "author": "nself",
  "category": "infrastructure",
  "description": "PostgreSQL backup and restore automation with scheduling",
  "entryPoint": "cmd/main",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "PORT",
      "required": false
    },
    {
      "description": "",
      "name": "BACKUP_STORAGE_PATH",
      "required": false
    },
    {
      "description": "",
      "name": "BACKUP_PG_DUMP_PATH",
      "required": false
    },
    {
      "description": "",
      "name": "BACKUP_PG_RESTORE_PATH",
      "required": false
    },
    {
      "description": "",
      "name": "PLUGIN_INTERNAL_SECRET",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "name": "backup",
  "port": 3050,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "schema": "np_backup",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3050
  },
  "status": "stable",
  "tables": [
    "np_backup_jobs",
    "np_backup_schedules"
  ],
  "tags": [
    "backup",
    "restore",
    "database",
    "automation",
    "disaster-recovery"
  ],
  "tier": "free",
  "version": "1.2.13"
}
