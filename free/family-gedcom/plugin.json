{
  "author": "nself",
  "category": "social",
  "description": "Generic GEDCOM file importer for the family plugin. Accepts any GEDCOM 5.5.1 / 7.0 file from any provider with optional photo-folder upload. PLANNED: requires the 'family' plugin (ɳFamily bundle, planned v1.1.0) and 'object-storage' + 'photos' plugins. Not installable until the family plugin ships.",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    }
  ],
  "homepage": "https://nself.org/plugins",
  "installable": false,
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "planned",
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "family-gedcom",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "storage",
      "temp",
      "logs"
    ],
    "network": []
  },
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "service": {
    "kind": "library"
  },
  "status": "planned",
  "tags": [
    "family",
    "genealogy",
    "gedcom",
    "migration",
    "importer"
  ],
  "tier": "free",
  "version": "1.2.13"
}
