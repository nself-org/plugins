{
  "arch_support": [
    "linux-x86_64",
    "linux-arm64",
    "darwin-arm64"
  ],
  "author": "nself",
  "capabilities": [
    "yjs_websocket",
    "automerge_http_sync",
    "offline_first",
    "awareness",
    "history_compaction"
  ],
  "category": "infrastructure",
  "description": "CRDT offline-first primitives. Self-hosted Yjs (y-websocket protocol) and automerge sync server with Postgres persistence. Drop-in replacement for Liveblocks/PartyKit with zero extra infra.",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "CRDT_ENGINE",
      "required": false
    },
    {
      "description": "",
      "name": "CRDT_MAX_DOC_SIZE_MB",
      "required": false
    },
    {
      "description": "",
      "name": "CRDT_RETENTION_DAYS",
      "required": false
    },
    {
      "description": "",
      "name": "CRDT_REDIS_URL",
      "required": false
    },
    {
      "description": "",
      "name": "CRDT_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": false
    },
    {
      "description": "",
      "name": "LOG_LEVEL",
      "required": false
    },
    {
      "description": "",
      "name": "CRDT_HOST",
      "required": false
    }
  ],
  "health_endpoint": "/health",
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "crdt",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs"
    ],
    "network": [
      "internal"
    ]
  },
  "port": 8211,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/crdt/compact/{docID}"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/crdt/doc/{docID}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/crdt/doc/{docID}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/crdt/docs"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/crdt/sync/{docID}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/crdt/yjs/{docID}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    }
  ],
  "schema": "np_crdt",
  "service": {
    "kind": "library",
    "port": 8211
  },
  "status": "stable",
  "tables": [
    "np_crdt_documents",
    "np_crdt_updates"
  ],
  "tags": [
    "crdt",
    "offline-first",
    "yjs",
    "automerge",
    "collaboration",
    "sync",
    "websocket",
    "realtime"
  ],
  "tier": "free",
  "version": "1.2.6",
  "webhooks": [
    "document.compacted",
    "document.created",
    "document.deleted",
    "document.updated"
  ]
}
