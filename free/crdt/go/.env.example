# CRDT plugin environment variables
# Copy to .env.local and fill in values.

# Required
DATABASE_URL=postgres://nself:nself@localhost:5432/nself

# Optional — defaults shown
CRDT_ENGINE=both              # yjs | automerge | both
CRDT_MAX_DOC_SIZE_MB=10       # max document state size in MB
CRDT_RETENTION_DAYS=90        # days to retain update history
CRDT_PORT=8211                # HTTP/WS listen port
# CRDT_REDIS_URL=redis://localhost:6379  # optional: multi-instance awareness sync
LOG_LEVEL=info                # debug | info | warn | error
