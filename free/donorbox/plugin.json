{
  "arch_support": [
    "linux-x86_64",
    "linux-arm64",
    "darwin-arm64"
  ],
  "author": "nself",
  "category": "commerce",
  "description": "Donorbox donation data sync with webhook handling",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "DONORBOX_API_KEY",
      "required": true
    },
    {
      "description": "",
      "name": "DONORBOX_EMAIL",
      "required": true
    },
    {
      "description": "",
      "name": "PORT",
      "required": false
    },
    {
      "description": "",
      "name": "DONORBOX_WEBHOOK_SECRET",
      "required": false
    },
    {
      "description": "",
      "name": "PLUGIN_INTERNAL_SECRET",
      "required": false
    }
  ],
  "health_endpoint": "/health",
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "0.9.9",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "donorbox",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache"
    ],
    "network": [
      "donorbox.org"
    ]
  },
  "port": 3074,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=0.9.9"
  },
  "schema": "np_donorbox",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3074
  },
  "status": "stable",
  "tables": [
    "np_donorbox_campaigns",
    "np_donorbox_donors",
    "np_donorbox_donations",
    "np_donorbox_plans",
    "np_donorbox_events",
    "np_donorbox_tickets",
    "np_donorbox_webhook_events"
  ],
  "tags": [
    "donations",
    "fundraising",
    "campaigns",
    "donorbox",
    "webhooks"
  ],
  "tier": "free",
  "version": "1.2.13",
  "webhooks": [
    "donation.created"
  ]
}
