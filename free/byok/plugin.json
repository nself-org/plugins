{
  "arch_support": [
    "linux-x86_64",
    "linux-arm64",
    "darwin-arm64"
  ],
  "author": "nself",
  "capabilities": [
    "envelope_encryption",
    "aws_kms",
    "gcp_kms",
    "vault_transit",
    "key_rotation",
    "audit_trail"
  ],
  "category": "compliance",
  "description": "Bring Your Own Key (BYOK) per-tenant encryption. Envelope encryption with customer-managed keys (CMK) via AWS KMS, GCP Cloud KMS, or HashiCorp Vault Transit. DEK wrapped by CMK. Satisfies HIPAA, FedRAMP High, FFIEC, and DORA key-control requirements. Enterprise-only.",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "BYOK_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_BYOK",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_BYOK_DEK_CACHE",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_BYOK_DEK_CACHE_TTL",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_BYOK_ROTATE_BATCH_SIZE",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_BYOK_ROTATE_RATE_LIMIT",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_BYOK_MULTI_REGION",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_LICENSE_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "LOG_LEVEL",
      "required": false
    }
  ],
  "health_endpoint": "/health",
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "experimental",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.9",
  "multiApp": {
    "isolationColumn": "tenant_id",
    "pkStrategy": "single",
    "supported": false
  },
  "name": "byok",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs"
    ],
    "network": [
      "kms.amazonaws.com",
      "cloudkms.googleapis.com",
      "vault"
    ]
  },
  "port": 3743,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.9"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/encryption/key-events"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/encryption/kms"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/encryption/kms"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/encryption/kms"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/encryption/kms/verify"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/encryption/rotate"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/encryption/rotate/{job_id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ready"
    }
  ],
  "schema": "np_byok",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3743
  },
  "status": "experimental",
  "tables": [
    "np_kms_configs",
    "np_encrypted_values",
    "np_encryption_key_events"
  ],
  "tags": [
    "encryption",
    "byok",
    "kms",
    "aws-kms",
    "gcp-kms",
    "vault",
    "hipaa",
    "fedramp",
    "enterprise",
    "security"
  ],
  "tier": "free",
  "version": "1.2.6",
  "webhooks": [
    "key.revoked",
    "key.rotated",
    "kms.configured",
    "kms.verified",
    "rotation.failed",
    "rotation.started"
  ]
}
