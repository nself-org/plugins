{
  "author": "nSelf Team",
  "category": "infrastructure",
  "description": "ɳCloud managed hosting infrastructure: tenant lifecycle, server provisioning saga, Stripe metered billing, custom domain management, and team memberships for cloud.nself.org.",
  "entryPoint": "nself-cloud",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "HETZNER_API_TOKEN",
      "required": true
    },
    {
      "description": "",
      "name": "STRIPE_PLATFORM_SECRET_KEY",
      "required": true
    },
    {
      "description": "",
      "name": "STRIPE_PLATFORM_WEBHOOK_SECRET",
      "required": true
    },
    {
      "description": "",
      "name": "NSELF_CLOUD_BASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "NSELF_DB_ENCRYPTION_KEY",
      "required": true
    },
    {
      "description": "",
      "name": "PORT",
      "required": false
    },
    {
      "description": "",
      "name": "NCLOUD_PROVISIONING_ENABLED",
      "required": false
    },
    {
      "description": "",
      "name": "BILLING_PROVIDER",
      "required": false
    },
    {
      "description": "",
      "name": "NCLOUD_TRIAL_DAYS",
      "required": false
    },
    {
      "description": "",
      "name": "NCLOUD_MANAGEMENT_FEE_CENTS",
      "required": false
    },
    {
      "description": "",
      "name": "NCLOUD_BYOH_FEE_CENTS",
      "required": false
    },
    {
      "description": "",
      "name": "HETZNER_SSH_KEY_ID",
      "required": false
    },
    {
      "description": "",
      "name": "NCLOUD_PROVISION_TIMEOUT_MINUTES",
      "required": false
    },
    {
      "description": "",
      "name": "LS_API_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "LS_WEBHOOK_SECRET",
      "required": false
    }
  ],
  "health_endpoint": "/health",
  "homepage": "https://nself.org/cloud",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "planned",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.1.0",
  "multiApp": {
    "supported": false
  },
  "name": "nself-cloud",
  "optionalDependencies": [
    "nself-stripe",
    "transactional-email"
  ],
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs"
    ],
    "network": [
      "api.hetzner.cloud",
      "api.stripe.com",
      "api.lemonsqueezy.com"
    ]
  },
  "port": 3855,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.1.0"
  },
  "rest_routes": [
    {
      "auth": "none",
      "method": "POST",
      "path": "/api/cloud/signup",
      "summary": "Create tenant + start trial. Rate: 5/IP/hour."
    },
    {
      "auth": "none",
      "method": "POST",
      "path": "/api/cloud/login",
      "summary": "Email+password or magic link — returns JWT."
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/cloud/me",
      "summary": "Current tenant + billing status."
    },
    {
      "auth": "none",
      "method": "POST",
      "path": "/api/cloud/waitlist",
      "summary": "Join waitlist when kill-switch on."
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/cloud/instances",
      "summary": "Trigger provisioning saga for a new instance."
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/cloud/instances",
      "summary": "List tenant instances."
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/cloud/instances/{id}",
      "summary": "Get instance detail + health status."
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/api/cloud/instances/{id}",
      "summary": "Initiate instance teardown."
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/cloud/instances/{id}/domain",
      "summary": "Bind a custom domain to an instance."
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/cloud/instances/{id}/domain/verify",
      "summary": "Check CNAME propagation for custom domain."
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/cloud/instances/{id}/logs",
      "summary": "Last 100 log lines from the instance."
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/cloud/invitations",
      "summary": "Invite a team member to an instance."
    },
    {
      "auth": "none",
      "method": "GET",
      "path": "/api/cloud/invitations/accept",
      "summary": "Accept an invitation via token."
    },
    {
      "auth": "none",
      "hmac": "STRIPE_PLATFORM_WEBHOOK_SECRET",
      "method": "POST",
      "path": "/webhooks/stripe",
      "summary": "Stripe platform webhook — HMAC verified, raw body required."
    },
    {
      "auth": "none",
      "hmac": "LS_WEBHOOK_SECRET",
      "method": "POST",
      "path": "/webhooks/lemonsqueezy",
      "summary": "Lemon Squeezy backup billing webhook."
    },
    {
      "auth": "none",
      "method": "GET",
      "path": "/health",
      "summary": "Liveness check."
    },
    {
      "auth": "none",
      "method": "GET",
      "path": "/ready",
      "summary": "Readiness check (DB connection)."
    },
    {
      "auth": "none",
      "method": "GET",
      "path": "/metrics",
      "summary": "Prometheus metrics."
    }
  ],
  "schema": "np_nself_cloud",
  "service": {
    "kind": "library",
    "port": 3855
  },
  "status": "planned",
  "tables": [
    "np_cloud_tenants",
    "np_cloud_instances",
    "np_cloud_billing_events",
    "np_cloud_domains",
    "np_cloud_invitations",
    "np_cloud_team_memberships"
  ],
  "tags": [
    "cloud",
    "hosting",
    "provisioning",
    "hetzner",
    "billing",
    "stripe",
    "multi-tenant",
    "saas"
  ],
  "tier": "free",
  "version": "1.2.13",
  "visibility": "internal"
}
