{
  "arch_support": [
    "linux-x86_64",
    "linux-arm64",
    "darwin-arm64"
  ],
  "author": "nself",
  "capabilities": [
    "deno_isolate_pool",
    "sse_log_stream",
    "env_allowlist",
    "prometheus_metrics",
    "version_history",
    "version_rollback"
  ],
  "category": "infrastructure",
  "description": "Edge Functions V8 Runtime. Deploy short-lived TypeScript functions with a Deno V8 isolate pool. HTTP-trigger, <50ms cold-start, allowlist-only env injection, Prometheus metrics, SSE log streaming.",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "FUNCTIONS_EDGE_ENABLED",
      "required": false
    },
    {
      "description": "",
      "name": "FUNCTIONS_EDGE_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "FUNCTIONS_EDGE_MAX_DURATION_MS",
      "required": false
    },
    {
      "description": "",
      "name": "FUNCTIONS_EDGE_POOL_SIZE",
      "required": false
    },
    {
      "description": "",
      "name": "FUNCTIONS_EDGE_MAX_MEMORY_MB",
      "required": false
    },
    {
      "description": "",
      "name": "FUNCTIONS_EDGE_LOG_RETENTION_DAYS",
      "required": false
    },
    {
      "description": "",
      "name": "DENO_BINARY_PATH",
      "required": false
    },
    {
      "description": "",
      "name": "PLUGIN_INTERNAL_SECRET",
      "required": false
    }
  ],
  "health_endpoint": "/health",
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.9",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "functions-v8",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "tmp",
      "logs"
    ],
    "network": [
      "outbound"
    ]
  },
  "port": 3088,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.9"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/functions/v1/{name}"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/functions/v1/{name}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/{name}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{name}"
    },
    {
      "auth": "bearer",
      "method": "PATCH",
      "path": "/{name}/activate"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{name}/env"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/{name}/env"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/{name}/env/{key}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{name}/logs"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{name}/logs/stream"
    }
  ],
  "schema": "np_functions_v8",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3088
  },
  "status": "stable",
  "tables": [
    "np_edge_functions",
    "np_edge_function_versions",
    "np_edge_function_env",
    "np_function_logs"
  ],
  "tags": [
    "functions",
    "serverless",
    "edge",
    "deno",
    "typescript",
    "v8",
    "isolate"
  ],
  "tier": "free",
  "version": "1.2.6",
  "webhooks": [
    "function.deleted",
    "function.deployed",
    "function.error",
    "function.invoked",
    "function.timeout"
  ]
}
