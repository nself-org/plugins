{
  "author": "nSelf Team",
  "category": "infrastructure",
  "description": "nSelf-managed envelope encryption KMS. Provides per-row/column selective encryption with key rotation, audit logging, and Hasura Action surface. Eliminates ad-hoc per-team AES wrappers.",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "VAULT_KEK_V1",
      "required": true
    },
    {
      "description": "",
      "name": "VAULT_KEK_V2",
      "required": false
    },
    {
      "default": "1",
      "description": "",
      "name": "VAULT_CURRENT_KEK_VERSION",
      "required": false
    },
    {
      "default": "500",
      "description": "",
      "name": "VAULT_ENCRYPT_RATE_RPM",
      "required": false
    },
    {
      "default": "1000",
      "description": "",
      "name": "VAULT_DECRYPT_RATE_RPM",
      "required": false
    },
    {
      "default": "365",
      "description": "",
      "name": "VAULT_AUDIT_RETENTION_DAYS",
      "required": false
    },
    {
      "default": "false",
      "description": "",
      "name": "VAULT_PLUGIN_ENABLED",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_JWT_SECRET",
      "required": true
    },
    {
      "default": "127.0.0.1",
      "description": "",
      "name": "VAULT_BIND",
      "required": false
    },
    {
      "default": "3823",
      "description": "",
      "name": "VAULT_PORT",
      "required": false
    }
  ],
  "health_endpoint": "/health",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "name": "nself-vault",
  "port": 3823,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "schema": "np_nself_vault",
  "service": {
    "kind": "library",
    "port": 3823
  },
  "status": "stable",
  "systemDependencies": {
    "required": [
      {
        "name": "libsodium",
        "verify": ""
      }
    ]
  },
  "tables": [
    "np_vault_devices",
    "np_vault_records",
    "np_vault_envelopes",
    "np_vault_audit"
  ],
  "tier": "free",
  "version": "1.2.13",
  "visibility": "public"
}
