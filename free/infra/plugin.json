{
  "arch_support": [
    "linux-x86_64",
    "linux-arm64",
    "darwin-arm64",
    "darwin-x86_64"
  ],
  "author": "nself",
  "binaryName": "nself-infra",
  "category": "infrastructure",
  "cliCommands": [
    {
      "description": "Provision nSelf infrastructure with OpenTofu/Terraform and manage Hetzner Cloud servers",
      "name": "infra"
    }
  ],
  "commands": {
    "binary": "nself-infra",
    "command": "infra",
    "json": "none",
    "output": "document",
    "side_effect": "remote",
    "subcommands": [
      {
        "flags": [
          {
            "name": "provider",
            "type": "string",
            "usage": "Cloud provider (hetzner)"
          }
        ],
        "json": "none",
        "name": "validate",
        "output": "document",
        "side_effect": "read",
        "summary": "Validate the Terraform module configuration"
      },
      {
        "flags": [
          {
            "name": "domain",
            "type": "string",
            "usage": "Domain for the nSelf deployment"
          },
          {
            "name": "provider",
            "type": "string",
            "usage": "Cloud provider (hetzner)"
          },
          {
            "name": "state-bucket",
            "type": "string",
            "usage": "S3/GCS bucket for Terraform state (optional)"
          }
        ],
        "json": "none",
        "name": "plan",
        "output": "document",
        "side_effect": "read",
        "summary": "Show the OpenTofu/Terraform plan for the given provider"
      },
      {
        "flags": [
          {
            "default": "false",
            "name": "auto-approve",
            "type": "bool",
            "usage": "Skip interactive approval"
          },
          {
            "name": "deploy-pubkey",
            "type": "string",
            "usage": "SSH public key content for the nself deploy user's authorized_keys - passed as TF var deploy_ssh_pubkey"
          },
          {
            "name": "domain",
            "type": "string",
            "usage": "Domain for the nSelf deployment"
          },
          {
            "default": "false",
            "name": "i-accept-cloud-spend",
            "type": "bool",
            "usage": "Accept that this command provisions real cloud resources and incurs cost"
          },
          {
            "name": "location",
            "type": "string",
            "usage": "Hetzner datacenter location (e.g. nbg1, fsn1, hel1) - passed as TF var"
          },
          {
            "name": "provider",
            "type": "string",
            "usage": "Cloud provider (hetzner)"
          },
          {
            "name": "server-type",
            "type": "string",
            "usage": "Hetzner server type (e.g. cpx21, cx22) - passed as TF var"
          },
          {
            "name": "state-bucket",
            "type": "string",
            "usage": "S3/GCS bucket for Terraform state (optional)"
          }
        ],
        "json": "none",
        "name": "apply",
        "output": "document",
        "side_effect": "remote",
        "summary": "Provision nSelf infrastructure via OpenTofu/Terraform"
      },
      {
        "confirm": {
          "flags": [
            "auto-approve"
          ]
        },
        "flags": [
          {
            "default": "false",
            "name": "auto-approve",
            "type": "bool",
            "usage": "Confirm destruction without prompt"
          },
          {
            "name": "domain",
            "type": "string",
            "usage": "Domain for the nSelf deployment"
          },
          {
            "name": "provider",
            "type": "string",
            "usage": "Cloud provider (hetzner)"
          },
          {
            "default": "false",
            "name": "i-accept-cloud-spend",
            "type": "bool",
            "usage": "Accept that this command destroys real cloud resources and affects running systems"
          }
        ],
        "json": "none",
        "name": "destroy",
        "output": "document",
        "side_effect": "destructive",
        "summary": "Destroy nSelf infrastructure"
      },
      {
        "flags": [
          {
            "name": "image",
            "type": "string",
            "usage": "OS image, e.g. ubuntu-24.04 (required)"
          },
          {
            "default": "false",
            "name": "json",
            "type": "bool",
            "usage": "output as JSON"
          },
          {
            "name": "label",
            "type": "string",
            "usage": "label as key=value (repeatable)"
          },
          {
            "name": "location",
            "type": "string",
            "usage": "datacenter location, e.g. fsn1 (required)"
          },
          {
            "name": "name",
            "type": "string",
            "usage": "server name (required)"
          },
          {
            "name": "ssh-key",
            "type": "string",
            "usage": "Hetzner SSH key name to authorize (repeatable)"
          },
          {
            "name": "token",
            "secret": true,
            "type": "string",
            "usage": "Hetzner Cloud API token (overrides --token-env)"
          },
          {
            "default": "HETZNER_NSELF_TOKEN",
            "name": "token-env",
            "type": "string",
            "usage": "env var to read the API token from"
          },
          {
            "name": "type",
            "type": "string",
            "usage": "server type, e.g. cx22 (required)"
          }
        ],
        "json": "none",
        "name": "server provision",
        "output": "document",
        "side_effect": "remote",
        "summary": "Create a new Hetzner Cloud server",
        "surface": "cli-only"
      },
      {
        "flags": [
          {
            "default": "false",
            "name": "json",
            "type": "bool",
            "usage": "output as JSON"
          },
          {
            "name": "label-selector",
            "type": "string",
            "usage": "filter by Hetzner label selector, e.g. managed-by=nself-cli"
          },
          {
            "name": "token",
            "secret": true,
            "type": "string",
            "usage": "Hetzner Cloud API token (overrides --token-env)"
          },
          {
            "default": "HETZNER_NSELF_TOKEN",
            "name": "token-env",
            "type": "string",
            "usage": "env var to read the API token from"
          }
        ],
        "json": "none",
        "name": "server list",
        "output": "document",
        "side_effect": "read",
        "summary": "List Hetzner Cloud servers",
        "surface": "cli-only"
      },
      {
        "confirm": {
          "flags": []
        },
        "flags": [
          {
            "name": "id",
            "type": "int",
            "usage": "server ID (required)"
          },
          {
            "default": "false",
            "name": "json",
            "type": "bool",
            "usage": "output as JSON"
          },
          {
            "name": "token",
            "secret": true,
            "type": "string",
            "usage": "Hetzner Cloud API token (overrides --token-env)"
          },
          {
            "default": "HETZNER_NSELF_TOKEN",
            "name": "token-env",
            "type": "string",
            "usage": "env var to read the API token from"
          },
          {
            "name": "type",
            "type": "string",
            "usage": "target server type, e.g. cx41 (required)"
          },
          {
            "default": "false",
            "name": "upgrade-disk",
            "type": "bool",
            "usage": "also grow the disk to match the new type (irreversible)"
          }
        ],
        "json": "none",
        "name": "server resize",
        "output": "document",
        "side_effect": "remote",
        "summary": "Change a server's type (CPU/RAM/disk)",
        "surface": "cli-only"
      },
      {
        "confirm": {
          "flags": [
            "snapshot"
          ]
        },
        "flags": [
          {
            "default": "false",
            "name": "force-no-backup",
            "type": "bool",
            "usage": "proceed without any backup (explicit acknowledgment)"
          },
          {
            "name": "id",
            "type": "int",
            "usage": "server ID (required)"
          },
          {
            "default": "false",
            "name": "json",
            "type": "bool",
            "usage": "output as JSON"
          },
          {
            "default": "false",
            "name": "release-ip",
            "type": "bool",
            "usage": "let the server's primary IP(s) be released with it, instead of retaining them"
          },
          {
            "default": "false",
            "name": "snapshot",
            "type": "bool",
            "usage": "take a snapshot and verify it before deleting"
          },
          {
            "default": "10m0s",
            "name": "snapshot-timeout",
            "type": "string",
            "usage": "how long to wait for the snapshot to become available"
          },
          {
            "name": "token",
            "secret": true,
            "type": "string",
            "usage": "Hetzner Cloud API token (overrides --token-env)"
          },
          {
            "default": "HETZNER_NSELF_TOKEN",
            "name": "token-env",
            "type": "string",
            "usage": "env var to read the API token from"
          }
        ],
        "json": "none",
        "name": "server destroy",
        "output": "document",
        "side_effect": "destructive",
        "summary": "Delete a Hetzner Cloud server (refuses without --snapshot or --force-no-backup)",
        "surface": "cli-only"
      }
    ],
    "summary": "Provision nSelf infrastructure with OpenTofu/Terraform and manage Hetzner Cloud servers"
  },
  "description": "Provision nSelf infrastructure with OpenTofu/Terraform: plan, apply and destroy modules for hetzner.",
  "entryPoint": "cmd/",
  "envVars": [
    {
      "description": "Hetzner token for the Terraform commands only (plan, apply, destroy); never read by nself infra server",
      "name": "NSELF_INFRA_TERRAFORM_HCLOUD_TOKEN",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "experimental",
  "minNselfVersion": "1.2.8",
  "multiApp": {
    "supported": false
  },
  "name": "infra",
  "permissions": {
    "database": [],
    "filesystem": [
      "read"
    ],
    "network": [
      "api.hetzner.cloud"
    ]
  },
  "pluginType": "cli",
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.2.8"
  },
  "service": {
    "kind": "cli"
  },
  "status": "experimental",
  "tags": [
    "infra",
    "terraform",
    "provisioning",
    "deploy",
    "hetzner",
    "server",
    "snapshot"
  ],
  "tier": "free",
  "version": "1.2.6"
}
