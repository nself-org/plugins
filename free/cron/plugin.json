{
  "arch_support": [
    "linux-x86_64",
    "linux-arm64",
    "darwin-arm64"
  ],
  "author": "nself",
  "category": "automation",
  "description": "Cron job scheduler. Register jobs with standard cron syntax, execute via HTTP callbacks, track run history.",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "PORT",
      "required": false
    },
    {
      "description": "",
      "name": "CRON_TIMEOUT_SECS",
      "required": false
    },
    {
      "description": "",
      "name": "CRON_RETENTION_DAYS",
      "required": false
    }
  ],
  "health_endpoint": "/health",
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "0.9.9",
  "name": "cron",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [],
    "network": [
      "outbound"
    ]
  },
  "port": 3051,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=0.9.9"
  },
  "schema": "np_cron",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3051
  },
  "status": "stable",
  "tables": [
    "np_cron_jobs",
    "np_cron_runs"
  ],
  "tags": [
    "cron",
    "scheduler",
    "jobs",
    "automation",
    "webhooks"
  ],
  "tier": "free",
  "version": "1.2.13"
}
