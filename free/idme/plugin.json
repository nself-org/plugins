{
  "author": "nself",
  "category": "authentication",
  "description": "ID.me OAuth authentication with government-grade identity verification for 7 groups",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "IDME_CLIENT_ID",
      "required": true
    },
    {
      "description": "",
      "name": "IDME_CLIENT_SECRET",
      "required": true
    },
    {
      "description": "",
      "name": "IDME_REDIRECT_URI",
      "required": true
    },
    {
      "description": "",
      "name": "IDME_SCOPES",
      "required": false
    },
    {
      "description": "",
      "name": "IDME_SANDBOX",
      "required": false
    },
    {
      "description": "",
      "name": "IDME_WEBHOOK_SECRET",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "idme",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache"
    ],
    "network": [
      "id.me",
      "idmelabs.com"
    ]
  },
  "port": 3820,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/badges"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/badges"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/groups"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/groups"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/groups/{id}"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/groups/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/stats"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/users/{user_id}/badges"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/users/{user_id}/verifications"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/verifications"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/verifications"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/verifications/callback"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/verifications/{id}"
    }
  ],
  "schema": "np_idme",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3820
  },
  "status": "stable",
  "tables": [
    "np_idme_verifications",
    "np_idme_groups",
    "np_idme_badges",
    "np_idme_attributes",
    "np_idme_webhook_events"
  ],
  "tags": [
    "authentication",
    "oauth",
    "idme",
    "identity",
    "verification",
    "military",
    "veterans"
  ],
  "tier": "free",
  "version": "1.2.13",
  "webhooks": [
    "attribute.updated",
    "group.revoked",
    "group.verified",
    "verification.completed",
    "verification.created",
    "verification.failed",
    "verification.updated"
  ]
}
