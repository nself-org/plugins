{
  "author": "nself",
  "category": "media",
  "description": "ROM metadata database, search, discovery, automated download orchestration, and multi-source scraping for nself-tv",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "ROM_DISCOVERY_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "ROM_DISCOVERY_ENABLE_SCRAPERS",
      "required": false
    },
    {
      "description": "",
      "name": "ROM_DISCOVERY_SCRAPER_SCHEDULE",
      "required": false
    },
    {
      "description": "",
      "name": "ROM_DISCOVERY_DEFAULT_QUALITY_MIN",
      "required": false
    },
    {
      "description": "",
      "name": "ROM_DISCOVERY_DEFAULT_POPULARITY_MIN",
      "required": false
    },
    {
      "description": "",
      "name": "ROM_DISCOVERY_MAX_CONCURRENT_DOWNLOADS",
      "required": false
    },
    {
      "description": "",
      "name": "ROM_DISCOVERY_MAX_DOWNLOAD_SIZE_MB",
      "required": false
    },
    {
      "description": "",
      "name": "ROM_DISCOVERY_RETRO_GAMING_URL",
      "required": false
    },
    {
      "description": "",
      "name": "ROM_DISCOVERY_CDN_URL",
      "required": false
    },
    {
      "description": "",
      "name": "LOG_LEVEL",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "rom-discovery",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache",
      "temp"
    ],
    "network": [
      "archive.org",
      "localhost"
    ]
  },
  "port": 3125,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/audit"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/audit"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/downloads"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/downloads"
    },
    {
      "auth": "bearer",
      "method": "PATCH",
      "path": "/downloads/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/legal"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/legal"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/metadata"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/metadata"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/metadata/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/metadata/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/popularity"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/popularity"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/scrapers"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/scrapers"
    },
    {
      "auth": "bearer",
      "method": "PATCH",
      "path": "/scrapers/{id}"
    }
  ],
  "schema": "np_rom_discovery",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3125
  },
  "status": "stable",
  "tables": [
    "np_romdisc_metadata",
    "np_romdisc_download_queue",
    "np_romdisc_scraper_jobs",
    "np_romdisc_popularity"
  ],
  "tags": [
    "rom",
    "retro-gaming",
    "emulation",
    "scraper",
    "archive-org",
    "metadata",
    "discovery",
    "download"
  ],
  "tier": "free",
  "version": "1.2.13"
}
