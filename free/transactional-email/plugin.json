{
  "author": "nself",
  "category": "communication",
  "description": "Provider-agnostic transactional email: template rendering, per-tenant domain management, SPF/DKIM reporting, delivery webhook relay.",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "EMAIL_DEFAULT_PROVIDER",
      "required": false
    },
    {
      "description": "",
      "name": "EMAIL_ELASTIC_API_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "EMAIL_SMTP_HOST",
      "required": false
    },
    {
      "description": "",
      "name": "EMAIL_SMTP_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "EMAIL_SMTP_USER",
      "required": false
    },
    {
      "description": "",
      "name": "EMAIL_SMTP_PASS",
      "required": false
    },
    {
      "description": "",
      "name": "EMAIL_POSTMARK_SERVER_TOKEN",
      "required": false
    },
    {
      "description": "",
      "name": "EMAIL_RATE_LIMIT_RPM",
      "required": false
    },
    {
      "description": "",
      "name": "EMAIL_WEBHOOK_SECRET",
      "required": false
    },
    {
      "description": "",
      "name": "TRANSACTIONAL_EMAIL_PROVIDER",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "planned",
  "minNselfVersion": "1.1.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "transactional-email",
  "optionalDependencies": [
    "mux",
    "notify"
  ],
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs"
    ],
    "network": [
      "api.elasticemail.com",
      "smtp.elasticemail.com",
      "api.postmarkapp.com"
    ]
  },
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.1.0"
  },
  "schema": "np_transactional_email",
  "service": {
    "kind": "library"
  },
  "status": "planned",
  "tables": [
    "np_temail_domains",
    "np_temail_messages",
    "np_temail_templates"
  ],
  "tags": [
    "email",
    "transactional",
    "smtp",
    "elastic-email",
    "postmark",
    "templates",
    "webhooks"
  ],
  "tier": "free",
  "version": "1.2.6",
  "webhooks": [
    "email.bounced",
    "email.delivered",
    "email.failed",
    "email.sent"
  ],
  "installable": false
}
