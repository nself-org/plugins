{
  "author": "nself",
  "category": "development",
  "description": "Self-hosted Forgejo git forge with Forgejo Actions enabled for external runners. No in-stack runner and no Docker socket mount; register runners on a CI node that is not a deploy host. Designed for the ops profile (ops server on staging/prod).",
  "entryPoint": "cmd/main.go",
  "envVars": [
    {
      "description": "",
      "name": "NSELF_FORGEJO_ADMIN_USER",
      "required": true
    },
    {
      "description": "",
      "name": "NSELF_FORGEJO_ADMIN_PASSWORD",
      "required": true
    },
    {
      "description": "",
      "name": "NSELF_FORGEJO_ADMIN_EMAIL",
      "required": true
    },
    {
      "description": "",
      "name": "FORGEJO_HTTP_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "FORGEJO_SSH_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "FORGEJO_DOMAIN",
      "required": false
    },
    {
      "description": "",
      "name": "FORGEJO_DISABLE_REGISTRATION",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "minNselfVersion": "1.1.1",
  "multiApp": {
    "supported": false
  },
  "name": "forgejo",
  "permissions": {
    "database": [],
    "filesystem": [
      "data/forgejo"
    ],
    "network": [
      "codeberg.org",
      "code.forgejo.org",
      "docker.io",
      "ghcr.io"
    ]
  },
  "port": 3844,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.1.1"
  },
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "image": "codeberg.org/forgejo/forgejo:9.0.3@sha256:3c34f11fe8b9983096eef3f8f25c2d2c21c4ae7504960cb203f0b075d1d8ed73",
    "kind": "compose",
    "port": 3844
  },
  "status": "stable",
  "tags": [
    "ci",
    "cd",
    "forgejo",
    "gitea",
    "actions",
    "self-hosted",
    "devops",
    "offline-ci"
  ],
  "tier": "free",
  "version": "1.2.13"
}
