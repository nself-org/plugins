# Stage 1: build
FROM golang:1.25-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /nself-home ./cmd/main.go

# Stage 2: runtime
FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S nself && adduser -S nself -G nself

WORKDIR /app
COPY --from=builder /nself-home .

EXPOSE 3127

USER nself:nself

ENTRYPOINT ["/app/nself-home"]
