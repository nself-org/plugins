{
  "arch_support": [
    "linux-x86_64",
    "linux-arm64",
    "darwin-arm64"
  ],
  "author": "nself",
  "category": "integrations",
  "description": "Home automation bridge. Connects Home Assistant and MQTT to ɳSelf, enabling smart device control, state monitoring, scene activation, and command logging.",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "PLUGIN_INTERNAL_SECRET",
      "required": true
    },
    {
      "description": "",
      "name": "HOME_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "HOME_ASSISTANT_URL",
      "required": false
    },
    {
      "description": "",
      "name": "HOME_ASSISTANT_TOKEN",
      "required": false
    },
    {
      "description": "",
      "name": "MQTT_BROKER_URL",
      "required": false
    }
  ],
  "health_endpoint": "/health",
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "default",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "home",
  "optionalDependencies": [
    "claw"
  ],
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [],
    "network": [
      "outbound"
    ]
  },
  "port": 3127,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/home/automations"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/home/automations/{id}/toggle"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/home/command"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/home/devices"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/home/scene/{scene_id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/home/state/{entity_id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ready"
    }
  ],
  "schema": "np_home",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3127
  },
  "status": "stable",
  "tables": [
    "np_home_connections",
    "np_home_devices",
    "np_home_command_log"
  ],
  "tags": [
    "home-assistant",
    "mqtt",
    "smart-home",
    "iot",
    "automation"
  ],
  "tier": "free",
  "version": "1.2.13"
}
