{
  "apiEndpoints": [
    "GET /health",
    "GET /v1/subtitles",
    "GET /v1/downloads",
    "GET /v1/stats",
    "POST /v1/search",
    "POST /v1/search/hash",
    "POST /v1/download",
    "POST /v1/sync",
    "POST /v1/qc",
    "POST /v1/normalize",
    "DELETE /v1/downloads/:id"
  ],
  "author": "nself",
  "category": "media",
  "cliCommands": [
    {
      "description": "Initialize database schema",
      "name": "init"
    },
    {
      "description": "Search for subtitles by query",
      "name": "search"
    },
    {
      "description": "Start HTTP API server",
      "name": "server"
    },
    {
      "description": "Synchronize subtitle timing with video using alass and/or ffsubsync",
      "name": "sync"
    },
    {
      "description": "Run QC validation checks on a subtitle file",
      "name": "qc"
    },
    {
      "description": "Convert subtitle to WebVTT format",
      "name": "normalize"
    }
  ],
  "description": "Subtitle search, download, and sync verification via OpenSubtitles",
  "envVars": [
    {
      "description": "PostgreSQL connection string",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "OpenSubtitles REST API key",
      "name": "OPENSUBTITLES_API_KEY",
      "required": false
    },
    {
      "default": "/tmp/subtitles",
      "description": "Directory for storing downloaded subtitle files",
      "name": "SUBTITLE_STORAGE_PATH",
      "required": false
    },
    {
      "default": "3204",
      "description": "",
      "name": "SUBTITLE_MANAGER_PORT",
      "required": false
    },
    {
      "default": "info",
      "description": "",
      "name": "LOG_LEVEL",
      "required": false
    },
    {
      "default": "alass",
      "description": "Path to alass binary",
      "name": "ALASS_PATH",
      "required": false
    },
    {
      "default": "ffsubsync",
      "description": "Path to ffsubsync binary",
      "name": "FFSUBSYNC_PATH",
      "required": false
    }
  ],
  "homepage": "https://github.com/nself-org/plugins/tree/main/plugins/subtitle-manager",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "subtitle-manager",
  "port": 3737,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "runtime": "go",
  "schema": "np_subtitle_manager",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3737
  },
  "status": "stable",
  "systemDependencies": {
    "recommended": [
      {
        "custom_install": "cargo install alass-cli",
        "name": "alass",
        "verify": "alass --version"
      },
      {
        "custom_install": "pip3 install ffsubsync",
        "name": "ffsubsync",
        "verify": "ffsubsync --version"
      }
    ],
    "required": [
      {
        "apt": "python3 python3-pip",
        "brew": "python3",
        "minVersion": "3.8",
        "name": "python3",
        "verify": "python3 --version"
      }
    ]
  },
  "tables": [
    "np_subtmgr_subtitles",
    "np_subtmgr_downloads",
    "np_subtmgr_qc_results"
  ],
  "tier": "free",
  "version": "1.2.6"
}
