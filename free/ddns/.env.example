# =============================================================================
# DDNS Plugin - Environment Configuration
# =============================================================================
# Dynamic DNS plugin with external IP monitoring and automated DNS record updates
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED - Auto-provided by nself CLI
# -----------------------------------------------------------------------------

# PostgreSQL connection string (auto-provided by nself)
DATABASE_URL=postgresql://postgres:password@localhost:5432/nself_db

# -----------------------------------------------------------------------------
# OPTIONAL - Server Configuration
# -----------------------------------------------------------------------------

# Server port (default from plugin.json: 3217)
DDNS_PLUGIN_PORT=3217

# Log level: debug, info, warn, error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# OPTIONAL - DNS Provider Configuration
# -----------------------------------------------------------------------------

# DNS provider to use (e.g., cloudflare, route53)
DDNS_PROVIDER=cloudflare

# Domain name to update (e.g., home.example.com)
DDNS_DOMAIN=your-domain.example.com

# API token for the DNS provider
DDNS_TOKEN=your-provider-api-token

# IP check interval in seconds (default: 300 = 5 minutes)
DDNS_CHECK_INTERVAL=300

# -----------------------------------------------------------------------------
# OPTIONAL - Cloudflare Provider
# -----------------------------------------------------------------------------

# Cloudflare API key (required when DDNS_PROVIDER=cloudflare)
DDNS_CLOUDFLARE_API_KEY=your-cloudflare-api-key

# Cloudflare Zone ID for the domain (required when DDNS_PROVIDER=cloudflare)
DDNS_CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id

# -----------------------------------------------------------------------------
# DDNS Features
# -----------------------------------------------------------------------------
#
# External IP Monitoring:
#   - Polls a public IP detection service at DDNS_CHECK_INTERVAL
#   - Detects IPv4 and IPv6 address changes
#   - Stores IP change history in the database
#
# DNS Record Updates:
#   - Automatically updates DNS A/AAAA records when IP changes
#   - Supports Cloudflare and Route53 as DNS providers
#   - Configurable per-domain via API
#
# Use Cases:
#   - Self-hosted services behind a dynamic residential IP
#   - Remote access to home lab or office networks
#   - Automated domain record management
# -----------------------------------------------------------------------------
