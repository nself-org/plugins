{
  "author": "nself",
  "category": "infrastructure",
  "description": "Dynamic DNS plugin with external IP monitoring. Planned: DNS provider API integration (Cloudflare, Route53) for automated record updates",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "DDNS_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "DDNS_PROVIDER",
      "required": false
    },
    {
      "description": "",
      "name": "DDNS_DOMAIN",
      "required": false
    },
    {
      "description": "",
      "name": "DDNS_TOKEN",
      "required": false
    },
    {
      "description": "",
      "name": "DDNS_CHECK_INTERVAL",
      "required": false
    },
    {
      "description": "",
      "name": "DDNS_CLOUDFLARE_API_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "DDNS_CLOUDFLARE_ZONE_ID",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "ddns",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache",
      "temp"
    ],
    "network": [
      "*"
    ]
  },
  "port": 3217,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/configs"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/configs"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/api/v1/configs/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/configs/{id}"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/api/v1/configs/{id}"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/configs/{id}/update"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/ip"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/stats"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/update"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/update-log"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/update-log/{config_id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ready"
    }
  ],
  "schema": "np_ddns",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3217
  },
  "status": "stable",
  "tables": [
    "np_ddns_config",
    "np_ddns_update_log"
  ],
  "tags": [
    "ddns",
    "dns",
    "dynamic-dns",
    "duckdns",
    "cloudflare",
    "remote-access"
  ],
  "tier": "free",
  "version": "1.2.6"
}
