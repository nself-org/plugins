{
  "author": "nself",
  "category": "data",
  "description": "Document management and generation service with templates, versioning, and sharing",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "DOCS_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "DOCS_APP_IDS",
      "required": false
    },
    {
      "description": "",
      "name": "DOCS_PDF_ENGINE",
      "required": false
    },
    {
      "description": "",
      "name": "DOCS_DEFAULT_TEMPLATE_ENGINE",
      "required": false
    },
    {
      "description": "",
      "name": "DOCS_STORAGE_PROVIDER",
      "required": false
    },
    {
      "description": "",
      "name": "DOCS_MAX_DOCUMENT_SIZE_MB",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "documents",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "storage",
      "temp",
      "logs"
    ],
    "network": []
  },
  "port": 3106,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/api/v1/shares/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/stats"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ready"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/{id}/archive"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/{id}/publish"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{id}/shares"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/{id}/shares"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{id}/versions"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/{id}/versions"
    }
  ],
  "schema": "np_documents",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3106
  },
  "status": "stable",
  "tables": [
    "np_documents_documents",
    "np_documents_templates",
    "np_documents_versions",
    "np_documents_shares",
    "np_documents_webhook_events"
  ],
  "tags": [
    "documents",
    "pdf",
    "templates",
    "generation",
    "versioning",
    "sharing"
  ],
  "tier": "free",
  "version": "1.2.6"
}
