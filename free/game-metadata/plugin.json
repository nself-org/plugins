{
  "author": "nself",
  "category": "media",
  "description": "Game metadata service with IGDB integration, ROM hash matching, tier requirements, and artwork management",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "GAME_METADATA_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "IGDB_CLIENT_ID",
      "required": false
    },
    {
      "description": "",
      "name": "IGDB_CLIENT_SECRET",
      "required": false
    },
    {
      "description": "",
      "name": "GAME_METADATA_ARTWORK_PATH",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "game-metadata",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache",
      "temp"
    ],
    "network": [
      "*"
    ]
  },
  "port": 3123,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/api/v1/artwork/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/stats"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/lookup"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ready"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/search"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{id}"
    }
  ],
  "schema": "np_game_metadata",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3123
  },
  "status": "stable",
  "tables": [
    "np_game_catalog",
    "np_game_metadata",
    "np_game_artwork",
    "np_game_platforms",
    "np_game_genres"
  ],
  "tags": [
    "games",
    "igdb",
    "metadata",
    "rom",
    "retro-gaming",
    "artwork"
  ],
  "tier": "free",
  "version": "1.2.6"
}
