# =============================================================================
# Game Metadata Plugin - Environment Configuration
# =============================================================================
# Game metadata service with IGDB integration, ROM hash matching, and artwork management
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED - Auto-provided by nself CLI
# -----------------------------------------------------------------------------

# PostgreSQL connection string (auto-provided by nself)
DATABASE_URL=postgresql://postgres:password@localhost:5432/nself_db

# -----------------------------------------------------------------------------
# OPTIONAL - Server Configuration
# -----------------------------------------------------------------------------

# Server port (default from plugin.json: 3211)
GAME_METADATA_PLUGIN_PORT=3211

# Log level: debug, info, warn, error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# OPTIONAL - IGDB Integration
# -----------------------------------------------------------------------------

# IGDB API client ID (from https://api.igdb.com — requires Twitch developer account)
# Required for game metadata enrichment and artwork fetching
IGDB_CLIENT_ID=your-igdb-client-id

# IGDB API client secret
# Required for game metadata enrichment and artwork fetching
IGDB_CLIENT_SECRET=your-igdb-client-secret

# -----------------------------------------------------------------------------
# OPTIONAL - Storage Configuration
# -----------------------------------------------------------------------------

# Local filesystem path for storing downloaded artwork
# Defaults to a subdirectory within the plugin data directory
GAME_METADATA_ARTWORK_PATH=/var/data/game-metadata/artwork

# -----------------------------------------------------------------------------
# Game Metadata Features
# -----------------------------------------------------------------------------
#
# Game Catalog:
#   - Store and manage a library of games with platform and genre associations
#   - Support for ROM hash matching (MD5, SHA1, SHA256, CRC32)
#   - Tier-based access controls for premium game metadata
#
# IGDB Enrichment:
#   - Fetch game metadata from IGDB (ratings, descriptions, release dates)
#   - Download and store cover art and screenshots
#   - Match games by title or IGDB ID
#
# Platforms & Genres:
#   - Manage game platform records (NES, SNES, PS1, etc.)
#   - Organize games by genre with hierarchical categories
#
# Artwork Management:
#   - Store cover art, screenshots, and banners
#   - Local path or remote URL storage
#   - Primary artwork designation per game
#
# Use Cases:
#   - Game library management for retro gaming setups
#   - ROM management with metadata enrichment
#   - Game discovery and catalog browsing
# -----------------------------------------------------------------------------
