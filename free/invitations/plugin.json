{
  "author": "nself",
  "category": "communication",
  "description": "Invitation management system with email/SMS delivery and tracking",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "INVITATIONS_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "INVITATIONS_DEFAULT_EXPIRY_HOURS",
      "required": false
    },
    {
      "description": "",
      "name": "INVITATIONS_CODE_LENGTH",
      "required": false
    },
    {
      "description": "",
      "name": "INVITATIONS_MAX_BULK_SIZE",
      "required": false
    },
    {
      "description": "",
      "name": "INVITATIONS_ACCEPT_URL_TEMPLATE",
      "required": false
    },
    {
      "description": "",
      "name": "INVITATIONS_API_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "INVITATIONS_RATE_LIMIT_MAX",
      "required": false
    },
    {
      "description": "",
      "name": "INVITATIONS_RATE_LIMIT_WINDOW_MS",
      "required": false
    }
  ],
  "homepage": "https://github.com/nself-org/plugins/tree/main/plugins/invitations",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "uuid",
    "supported": true
  },
  "name": "invitations",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache"
    ],
    "network": [
      "*"
    ]
  },
  "port": 3402,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "schema": "np_invitations",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3402
  },
  "status": "stable",
  "tables": [
    "np_invitations_invitations"
  ],
  "tags": [
    "invitations",
    "invite",
    "onboarding",
    "email",
    "sms",
    "referrals"
  ],
  "tier": "free",
  "version": "1.2.13",
  "webhooks": [
    "bulk.completed",
    "bulk.started",
    "invitation.accepted",
    "invitation.created",
    "invitation.declined",
    "invitation.delivered",
    "invitation.expired",
    "invitation.revoked",
    "invitation.sent",
    "template.created",
    "template.updated"
  ]
}
