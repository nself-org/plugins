{
  "arch_support": [
    "linux-x86_64",
    "linux-arm64",
    "darwin-arm64"
  ],
  "author": "nself",
  "category": "content",
  "description": "LinkedIn publishing integration. OAuth 2.0 connection, post to LinkedIn feed with optional image attachments, post history, and Claw tool descriptor.",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "LINKEDIN_CLIENT_ID",
      "required": true
    },
    {
      "description": "",
      "name": "LINKEDIN_CLIENT_SECRET",
      "required": true
    },
    {
      "description": "",
      "name": "LINKEDIN_REDIRECT_URI",
      "required": true
    },
    {
      "description": "",
      "name": "LINKEDIN_INTERNAL_SECRET",
      "required": true
    },
    {
      "description": "",
      "name": "PORT",
      "required": false
    },
    {
      "description": "",
      "name": "BIND_ADDRESS",
      "required": false
    },
    {
      "description": "",
      "name": "NSELF_PLUGIN_LICENSE_KEY",
      "required": false
    }
  ],
  "health_endpoint": "/health",
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "default",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "linkedin",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [],
    "network": [
      "outbound"
    ]
  },
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/internal/tools"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/linkedin/auth"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/linkedin/auth/callback"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/linkedin/auth/start"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/linkedin/posts"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/linkedin/publish"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/linkedin/status"
    }
  ],
  "schema": "np_linkedin",
  "service": {
    "kind": "library",
    "port": 3722
  },
  "status": "stable",
  "tables": [
    "np_linkedin_tokens",
    "np_linkedin_posts"
  ],
  "tags": [
    "linkedin",
    "social",
    "publishing",
    "oauth",
    "content"
  ],
  "tier": "free",
  "version": "1.2.13"
}
