      "outbound-http"
    ]
  },
  "port": 3736,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "schema": "np_link_preview",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
