{
  "author": "nself",
  "category": "content",
  "description": "URL metadata extraction with Open Graph, Twitter Cards, and caching",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "PORT",
      "required": false
    },
    {
      "description": "",
      "name": "PLUGIN_INTERNAL_SECRET",
      "required": false
    }
  ],
  "homepage": "https://github.com/nself-org/plugins/tree/main/plugins/link-preview",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "migrations": {
    "apply": "boot",
    "dir": "migrations"
  },
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "supported": false
  },
  "name": "link-preview",
  "permissions": {
