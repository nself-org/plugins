#!/bin/sh
# Fake `tart` for unit tests. State lives in $FAKE_TART_DIR. FAKE_TART_FAIL=clone|run|ip|delete|stop|list breaks that step.
D="${FAKE_TART_DIR:?}"
mkdir -p "$D/vms"
echo "$*" >> "$D/tart.log"
fail() { [ "$FAKE_TART_FAIL" = "$1" ]; }
running() { [ -f "$D/vms/$1/pid" ] && kill -0 "$(cat "$D/vms/$1/pid")" 2>/dev/null; }
cmd="$1"; shift
case "$cmd" in
--version) echo "2.99.0-fake" ;;
list)
  fail list && { echo "boom" >&2; exit 1; }
  printf '['
  sep=''
  for v in "$D"/vms/*; do
    [ -d "$v" ] || continue
    n=$(basename "$v")
    r=false; running "$n" && r=true
    printf '%s{"Source":"local","Name":"%s","Running":%s,"State":"stopped"}' "$sep" "$n" "$r"
    sep=','
  done
  if [ -n "$FAKE_TART_EXTRA_RUNNING" ]; then
    i=0
    while [ $i -lt "$FAKE_TART_EXTRA_RUNNING" ]; do
      printf '%s{"Source":"local","Name":"other-%s","Running":true,"State":"running"}' "$sep" "$i"; sep=','; i=$((i+1))
    done
  fi
  [ -f "$D/cached" ] && printf '%s{"Source":"OCI","Name":"%s","Running":false,"State":"stopped"}' "$sep" "$(cat "$D/cached")"
  printf ']\n'
  ;;
clone)
  fail clone && { echo "clone failed" >&2; exit 1; }
  mkdir -p "$D/vms/$2/home"
  ;;
set) echo "$*" >> "$D/set.log" ;;
run)
  if [ "$1" = "--help" ]; then
    echo "  --net-softnet"
    [ -z "$FAKE_TART_NOBLOCK" ] && { echo "  --net-softnet-allow <cidrs>"; echo "  --net-softnet-block <cidrs>"; }
    exit 0
  fi
  echo "$*" > "$D/run.argv"
  for last; do :; done
  fail run && exit 3
  [ -d "$D/vms/$last" ] || { echo "no such VM" >&2; exit 1; }
  echo $$ > "$D/vms/$last/pid"
  trap 'rm -f "$D/vms/$last/pid"; exit 0' TERM INT
  while :; do sleep 0.2; done
  ;;
ip)
  fail ip && exit 1
  for last; do :; done
  running "$last" || { echo "VM not running" >&2; exit 1; }
  echo "${FAKE_TART_IP:-192.168.64.7}"
  ;;
stop)
  fail stop && exit 1
  if running "$1"; then kill "$(cat "$D/vms/$1/pid")" 2>/dev/null; sleep 0.3; fi
  ;;
delete)
  fail delete && { echo "delete refused" >&2; exit 1; }
  running "$1" && { echo "VM is running" >&2; exit 1; }
  [ -d "$D/vms/$1" ] || { echo "does not exist" >&2; exit 1; }
  rm -rf "$D/vms/$1"
  ;;
*) echo "unknown $cmd" >&2; exit 2 ;;
esac
