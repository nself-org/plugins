{
  "cache": {
    "disable": false
  },
  "jobs": {
    "build": {
      "artifacts": [
        {
          "kind": "binary",
          "path": "out.bin"
        }
      ],
      "cache": {
        "keys": [
          "go"
        ],
        "paths": [
          ".cache"
        ]
      },
      "kind": "build",
      "requires": {
        "accelerators": [
          "gpu"
        ],
        "cpu": 4,
        "labels": [
          "xcode",
          "arch=arm64"
        ],
        "mem_mb": 8192,
        "tools": [
          "xcode"
        ]
      },
      "run": [
        "go",
        "test",
        "./..."
      ],
      "runner_credential": "secret",
      "secrets": [
        "project/token"
      ]
    }
  },
  "version": 1
}
