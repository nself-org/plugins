# GENERATED BY nself ci providers gitlab init — DO NOT HAND EDIT
# template: v{{.Version}}
# agent-source: source
# agent-commit: {{.AgentCommit}}
#
# One hosted attempt of the nSelf CI fabric. The coordinator creates the pipeline through the pipeline
# API with `inputs` (GitLab 17.10 and later) or with variables of the same names; either way every
# value reaches the job as an environment variable and never as part of a script. The job runs only
# when NSELF_CI_NONCE is set, so the project's own pipelines are untouched. Include this file from
# .gitlab-ci.yml and forward the inputs if you use them. Edit the template and run the command again.
spec:
  inputs:
    spec:
      default: ''
    spec_digest:
      default: ''
    revision:
      default: ''
    fetch_ref:
      default: ''
    attempt:
      default: ''
    nonce:
      default: ''
    compat:
      default: v1.5
    runner_tag:
      default: {{.DefaultTag}}
    timeout_minutes:
      default: '60'
---
variables:
  NSELF_CI_SPEC: '$[[ inputs.spec ]]'
  NSELF_CI_SPEC_DIGEST: '$[[ inputs.spec_digest ]]'
  NSELF_CI_REVISION: '$[[ inputs.revision ]]'
  NSELF_CI_FETCH_REF: '$[[ inputs.fetch_ref ]]'
  NSELF_CI_ATTEMPT: '$[[ inputs.attempt ]]'
  NSELF_CI_NONCE: '$[[ inputs.nonce ]]'
  NSELF_CI_COMPAT: '$[[ inputs.compat ]]'
  NSELF_CI_RUNNER_TAG: '$[[ inputs.runner_tag ]]'
  NSELF_CI_TIMEOUT_MINUTES: '$[[ inputs.timeout_minutes ]]'

workflow:
  name: '$NSELF_CI_PIPELINE_NAME'
  rules:
    - if: '$NSELF_CI_NONCE'
      variables:
        NSELF_CI_PIPELINE_NAME: 'nself-ci $NSELF_CI_NONCE'
    - when: always

nself-ci:
  stage: test
  image: {{.Image}}
  tags:
    - '$NSELF_CI_RUNNER_TAG'
  rules:
    - if: '$NSELF_CI_NONCE'
  script:
    - |
      set -eu
      want="$NSELF_CI_REVISION"
      fetch="${NSELF_CI_FETCH_REF:-$want}"
      git fetch --quiet --depth 1 origin "$fetch"
      git checkout --quiet --detach FETCH_HEAD
      got="$(git rev-parse HEAD)"
      if [ "$got" != "$want" ]; then
        echo "checked out $got, the admitted revision is $want" >&2
        exit 1
      fi
      work="$(mktemp -d)"
      src="$work/agent-src"
      git init --quiet "$src"
      git -C "$src" fetch --quiet --depth 1 https://github.com/nself-org/plugins.git {{.AgentCommit}}
      git -C "$src" checkout --quiet FETCH_HEAD
      (cd "$src/free/ci" && CGO_ENABLED=0 go build -mod=vendor -trimpath -o "$work/nself-ci-agent" ./cmd/agent)
      printf '%s' "$NSELF_CI_SPEC" | base64 -d | gzip -dc > "$work/job.json"
      sum="$(sha256sum "$work/job.json" | cut -d ' ' -f 1)"
      if [ "sha256:$sum" != "$NSELF_CI_SPEC_DIGEST" ]; then
        echo "the job spec does not match its digest" >&2
        exit 1
      fi
      printf '{"attempt_id":"%s","coordinator_id":"gitlab","job_id":"job","job":%s,"revision":"%s","source_dir":"%s"}' \
        "$NSELF_CI_ATTEMPT" "$(cat "$work/job.json")" "$want" "$CI_PROJECT_DIR" > "$work/spec.json"
      if [ "$NSELF_CI_COMPAT" = "v1.5" ]; then export NSELF_V15=1; fi
      export NSELF_CI_COMPAT_MODE="$NSELF_CI_COMPAT"
      timeout "${NSELF_CI_TIMEOUT_MINUTES}m" "$work/nself-ci-agent" exec --spec "$work/spec.json" --evidence "$CI_PROJECT_DIR/evidence.json"
  artifacts:
    when: always
    expire_in: 1 day
    paths:
      - evidence.json
