# GENERATED BY nself ci providers gitlab init — DO NOT HAND EDIT
# template: v{{.Version}}
# agent-source: source
# agent-commit: {{.AgentCommit}}
#
# One hosted attempt of the nSelf CI fabric. The coordinator creates a pipeline through the pipeline API
# and the values reach the job as NSELF_CI_* environment variables, never as part of a script. The job
# runs only when NSELF_CI_NONCE is set on a pipeline created through the API, so the project's own
# pipelines are untouched and a pipeline someone starts by hand or by a push never runs it.
# Include this file from the main .gitlab-ci.yml (the job uses the stage test: add it to your stages: list
# if you have one; a project that sets its own workflow:rules also needs a rule that sets
# NSELF_CI_PIPELINE_NAME, see the workflow block below):
#   include:
#     - local: .gitlab/nself-ci.gitlab-ci.yml
# The values travel as pipeline variables on every GitLab version. GitLab 17.10 and later can take them
# as pipeline inputs instead (new projects may refuse pipeline variables). Inputs must be declared in
# the main .gitlab-ci.yml, so use this as its start (the coordinator sends inputs only when the main
# file at the pipeline ref declares all of them, and variables otherwise):
{{.Snippet}}
# Edit the template and run the command again.
workflow:
  name: '$NSELF_CI_PIPELINE_NAME'
  rules:
    - if: '$NSELF_CI_NONCE'
      variables:
        NSELF_CI_PIPELINE_NAME: 'nself-ci $NSELF_CI_NONCE'
    - when: always

nself-ci:
  stage: test
  needs: []
  dependencies: []
  image: {{.Image}}
  tags:
    - '$NSELF_CI_RUNNER_TAG'
  rules:
    - if: '$NSELF_CI_NONCE && $CI_PIPELINE_SOURCE == "api"'
  script:
    - |
      set -eu
      rm -f "$CI_PROJECT_DIR/evidence.json"
      want="$NSELF_CI_REVISION"
      fetch="${NSELF_CI_FETCH_REF:-$want}"
      git fetch --quiet --depth 1 origin "$fetch"
      git checkout --quiet --detach FETCH_HEAD
      got="$(git rev-parse HEAD)"
      if [ "$got" != "$want" ]; then
        echo "checked out $got, the admitted revision is $want" >&2
        exit 1
      fi
      work="$(mktemp -d)"
      src="$work/agent-src"
      git init --quiet "$src"
      git -C "$src" fetch --quiet --depth 1 https://github.com/nself-org/plugins.git {{.AgentCommit}}
      git -C "$src" checkout --quiet FETCH_HEAD
      (cd "$src/free/ci" && CGO_ENABLED=0 go build -mod=vendor -trimpath -o "$work/nself-ci-agent" ./cmd/agent)
      spec="${NSELF_CI_SPEC:-}${NSELF_CI_SPEC_0:-}${NSELF_CI_SPEC_1:-}${NSELF_CI_SPEC_2:-}${NSELF_CI_SPEC_3:-}${NSELF_CI_SPEC_4:-}${NSELF_CI_SPEC_5:-}${NSELF_CI_SPEC_6:-}${NSELF_CI_SPEC_7:-}${NSELF_CI_SPEC_8:-}${NSELF_CI_SPEC_9:-}"
      printf '%s' "$spec" | base64 -d | gzip -dc > "$work/job.json"
      sum="$(sha256sum "$work/job.json" | cut -d ' ' -f 1)"
      if [ "sha256:$sum" != "$NSELF_CI_SPEC_DIGEST" ]; then
        echo "the job spec does not match its digest" >&2
        exit 1
      fi
      printf '{"attempt_id":"%s","coordinator_id":"gitlab","job_id":"job","job":%s,"revision":"%s","source_dir":"%s"}' \
        "$NSELF_CI_ATTEMPT" "$(cat "$work/job.json")" "$want" "$CI_PROJECT_DIR" > "$work/spec.json"
      if [ "$NSELF_CI_COMPAT" = "v1.5" ]; then export NSELF_V15=1; fi
      export NSELF_CI_COMPAT_MODE="$NSELF_CI_COMPAT"
      timeout "${NSELF_CI_TIMEOUT_MINUTES}m" "$work/nself-ci-agent" exec --spec "$work/spec.json" --evidence "$CI_PROJECT_DIR/evidence.json"
  artifacts:
    when: always
    expire_in: 1 day
    paths:
      - evidence.json
