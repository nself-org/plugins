# GENERATED BY nself ci providers github init — DO NOT HAND EDIT
# template: v[[.Version]]
# agent-source: [[.AgentSource]]
[[- if eq .AgentSource "source"]]
# agent-commit: [[.AgentCommit]]
[[- else]]
# agent-release: [[.ReleaseVersion]]
[[- end]]
#
# One hosted attempt of the nSelf CI fabric. The coordinator dispatches it with
# workflow_dispatch; every input reaches the steps through env: and never
# through a script body. Edit the template and run the command again.
name: nself-ci-dispatch
run-name: nself-ci ${{ inputs.nonce }}

on:
  workflow_dispatch:
    inputs:
      spec:
        description: Job spec, gzip then base64 (at most 48 KiB encoded)
        required: true
        type: string
      spec_digest:
        description: sha256 of the decoded job spec
        required: true
        type: string
      revision:
        description: Admitted commit the job runs against
        required: true
        type: string
      fetch_ref:
        description: Ref to fetch when the commit is not on a branch (a fork pull request head)
        required: false
        default: ''
        type: string
      attempt:
        description: Attempt id
        required: true
        type: string
      nonce:
        description: Correlation nonce, carried in the run title
        required: true
        type: string
      runner_label:
        description: Standard GitHub-hosted runner label
        required: true
        type: choice
        options:
[[- range .Labels]]
          - [[.]]
[[- end]]
      compat_mode:
        description: Fabric compatibility mode
        required: true
        type: choice
        default: v1.5
        options:
[[- range .CompatModes]]
          - [[.]]
[[- end]]
      timeout_minutes:
        description: Job timeout in minutes
        required: true
        type: choice
        default: '60'
        options:
[[- range .Timeouts]]
          - '[[.]]'
[[- end]]

permissions:
  contents: read

jobs:
  run:
    name: nself-ci
    runs-on: ${{ inputs.runner_label }}
    timeout-minutes: ${{ fromJSON(inputs.timeout_minutes) }}
    defaults:
      run:
        shell: bash
    steps:
      - name: Check out the revision
        uses: [[.Checkout.Uses]] # [[.Checkout.Version]]
        with:
          ref: ${{ inputs.fetch_ref != '' && inputs.fetch_ref || inputs.revision }}
          persist-credentials: false
          fetch-depth: 1

      - name: Verify the checked-out revision
        env:
          REVISION: ${{ inputs.revision }}
        run: |
          got="$(git rev-parse HEAD)"
          if [ "$got" != "$REVISION" ]; then
            echo "checked out $got, the admitted revision is $REVISION" >&2
            exit 1
          fi
[[if eq .AgentSource "source"]]
      - name: Fetch the agent source
        run: |
          src="$RUNNER_TEMP/agent-src"
          git init --quiet "$src"
          git -C "$src" fetch --quiet --depth 1 https://github.com/nself-org/plugins.git [[.AgentCommit]]
          git -C "$src" checkout --quiet FETCH_HEAD

      - name: Set up Go
        uses: [[.SetupGo.Uses]] # [[.SetupGo.Version]]
        with:
          go-version-file: ${{ runner.temp }}/agent-src/free/ci/go.mod
          cache: false

      - name: Build the agent
        working-directory: ${{ runner.temp }}/agent-src/free/ci
        env:
          CGO_ENABLED: '0'
        run: |
          mkdir -p "$RUNNER_TEMP/bin"
          go build -mod=vendor -trimpath -o "$RUNNER_TEMP/bin/nself-ci-agent$(go env GOEXE)" ./cmd/agent
[[- else]]
      - name: Install the signed agent release
        run: |
          case "$RUNNER_OS-$RUNNER_ARCH" in
[[- range .Pins]]
            [[.RunnerOS]]-[[.RunnerArch]])
              url='[[.URL]]'
              sum='[[.SHA256]]'
              ;;
[[- end]]
            *)
              echo "no signed agent release for $RUNNER_OS-$RUNNER_ARCH" >&2
              exit 1
              ;;
          esac
          mkdir -p "$RUNNER_TEMP/bin"
          curl --fail --silent --show-error --location --proto '=https' --output "$RUNNER_TEMP/bin/nself-ci-agent" "$url"
          echo "$sum  $RUNNER_TEMP/bin/nself-ci-agent" | shasum -a 256 -c -
          chmod 0755 "$RUNNER_TEMP/bin/nself-ci-agent"
[[- end]]

      - name: Run the job
        env:
          NSELF_V15: ${{ inputs.compat_mode == 'v1.5' && '1' || '' }}
          NSELF_CI_COMPAT_MODE: ${{ inputs.compat_mode }}
          SPEC: ${{ inputs.spec }}
          SPEC_DIGEST: ${{ inputs.spec_digest }}
          REVISION: ${{ inputs.revision }}
          ATTEMPT: ${{ inputs.attempt }}
        run: |
          set -euo pipefail
          work="$RUNNER_TEMP/nself-ci"
          mkdir -p "$work/evidence"
          printf '%s' "$SPEC" | base64 -d | gzip -dc > "$work/job.json"
          got="$(shasum -a 256 "$work/job.json" | cut -d ' ' -f 1)"
          if [ "sha256:$got" != "$SPEC_DIGEST" ]; then
            echo "the job spec does not match its digest" >&2
            exit 1
          fi
          jq -n --slurpfile job "$work/job.json" --arg attempt "$ATTEMPT" --arg revision "$REVISION" --arg dir "$GITHUB_WORKSPACE" \
            '{attempt_id: $attempt, coordinator_id: "github-hosted", job_id: "job", job: $job[0], revision: $revision, source_dir: $dir}' > "$work/spec.json"
          agent="$RUNNER_TEMP/bin/nself-ci-agent"
          if [ -f "$agent.exe" ]; then agent="$agent.exe"; fi
          "$agent" exec --spec "$work/spec.json" --evidence "$work/evidence/evidence.json"

      - name: Upload the evidence
        if: always()
        uses: [[.Upload.Uses]] # [[.Upload.Version]]
        with:
          name: nself-ci-evidence-${{ inputs.nonce }}
          path: ${{ runner.temp }}/nself-ci/evidence/evidence.json
          retention-days: 1
          if-no-files-found: error
