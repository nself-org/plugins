{
  "$id": "https://nself.org/schemas/pool.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ci.pool/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,30}$"
    },
    "scope": {
      "type": "string",
      "enum": [
        "operator",
        "project",
        "hosted"
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "runner_id": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "local",
              "registry",
              "coordinator",
              "provider"
            ]
          }
        },
        "required": [
          "runner_id",
          "location",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "effective": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "const": "pool.excluded"
              },
              "detail": {
                "type": "string",
                "enum": [
                  "not_in_project_list",
                  "not_enrolled",
                  "dev_not_allowed"
                ]
              }
            },
            "required": [
              "code",
              "detail"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "allowed",
        "reasons"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "allowed": {
                "const": true
              }
            },
            "required": [
              "allowed"
            ]
          },
          "then": {
            "properties": {
              "reasons": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "allowed": {
                "const": false
              }
            },
            "required": [
              "allowed"
            ]
          },
          "then": {
            "properties": {
              "reasons": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema",
    "id",
    "scope",
    "members",
    "effective"
  ],
  "additionalProperties": false
}
