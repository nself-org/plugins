{
  "name": "tmdb",
  "version": "1.1.2",
  "api_version": "1.0.0",
  "description": "Comprehensive media metadata enrichment from TMDB/IMDb/TVDB/MusicBrainz with auto-matching, manual review queue, and multi-provider support",
  "author": "nself",
  "license": "MIT",
  "isCommercial": false,
  "licenseType": "free",
  "requiredEntitlements": [],
  "requires_license": false,
  "minNselfVersion": "1.0.0",
  "category": "media",
  "tags": [
    "tmdb",
    "metadata",
    "movies",
    "tv-shows",
    "imdb",
    "tvdb",
    "musicbrainz",
    "media",
    "matching",
    "enrichment"
  ],
  "tables": [
    "np_tmdb_movies",
    "np_tmdb_tv_shows",
    "np_tmdb_tv_seasons",
    "np_tmdb_tv_episodes",
    "np_tmdb_genres",
    "np_tmdb_match_queue",
    "np_tmdb_webhook_events"
  ],
  "webhooks": {},
  "actions": {
    "search": "Search TMDB for movies/TV shows",
    "match": "Match a media file to TMDB",
    "match-batch": "Batch match media files",
    "queue": "View match review queue",
    "confirm": "Confirm a match",
    "refresh": "Refresh cached metadata",
    "sync": "Sync genres and configuration",
    "status": "Show sync status"
  },
  "envVars": {
    "required": [
      "DATABASE_URL",
      "TMDB_API_KEY"
    ],
    "optional": [
      "TMDB_PLUGIN_PORT",
      "TMDB_APP_IDS",
      "TMDB_API_READ_ACCESS_TOKEN",
      "OMDB_API_KEY",
      "TVDB_API_KEY",
      "MUSICBRAINZ_USER_AGENT",
      "TMDB_AUTO_ACCEPT_THRESHOLD",
      "TMDB_DEFAULT_LANGUAGE",
      "TMDB_CACHE_TTL_DAYS",
      "TMDB_REFRESH_CRON"
    ]
  },
  "multiApp": {
    "supported": true,
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "defaultValue": "primary"
  },
  "config": {
    "autoAcceptThreshold": 0.85,
    "defaultLanguage": "en-US",
    "cacheTtlDays": 30,
    "refreshCron": "0 6 * * 0",
    "posterSize": "w500",
    "backdropSize": "w1280"
  },
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "network": [
      "api.themoviedb.org",
      "www.omdbapi.com",
      "api.thetvdb.com",
      "musicbrainz.org"
    ],
    "filesystem": [
      "logs",
      "cache"
    ]
  },
  "homepage": "https://nself.org/plugins",
  "repository": "https://github.com/nself-org/plugins-pro",
  "port": 3122,
  "language": "go",
  "entryPoint": "binary",
  "status": "stable",
  "tier": "pro",
  "routes": [
    {
      "method": "GET",
      "path": "/",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/api/v1/stats",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/confirm",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/health",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/match",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/match-batch",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/queue",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/ready",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/refresh",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/search",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/status",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/sync",
      "auth": "bearer"
    },
    {
      "method": "DELETE",
      "path": "/{id}",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/{id}",
      "auth": "bearer"
    },
    {
      "method": "PUT",
      "path": "/{id}",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/{id}/seasons",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/{id}/seasons",
      "auth": "bearer"
    },
    {
      "method": "GET",
      "path": "/{id}/seasons/{season}/episodes",
      "auth": "bearer"
    },
    {
      "method": "POST",
      "path": "/{id}/seasons/{season}/episodes",
      "auth": "bearer"
    }
  ],
  "dependencies": {
    "required": [],
    "optional": []
  },
  "entry": "cmd/main.go",
  "checksum": "48de57901043cfcb9df27a4e0162864948e9db4815f4e2c4c0952c8618e9f542",
