{
  "author": "nself",
  "category": "media",
  "description": "Comprehensive media metadata enrichment from TMDB/IMDb/TVDB/MusicBrainz with auto-matching, manual review queue, and multi-provider support",
  "entryPoint": "binary",
  "envVars": [
    {
      "description": "",
      "name": "DATABASE_URL",
      "required": true
    },
    {
      "description": "",
      "name": "TMDB_API_KEY",
      "required": true
    },
    {
      "description": "",
      "name": "TMDB_PLUGIN_PORT",
      "required": false
    },
    {
      "description": "",
      "name": "TMDB_APP_IDS",
      "required": false
    },
    {
      "description": "",
      "name": "TMDB_API_READ_ACCESS_TOKEN",
      "required": false
    },
    {
      "description": "",
      "name": "OMDB_API_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "TVDB_API_KEY",
      "required": false
    },
    {
      "description": "",
      "name": "MUSICBRAINZ_USER_AGENT",
      "required": false
    },
    {
      "description": "",
      "name": "TMDB_AUTO_ACCEPT_THRESHOLD",
      "required": false
    },
    {
      "description": "",
      "name": "TMDB_DEFAULT_LANGUAGE",
      "required": false
    },
    {
      "description": "",
      "name": "TMDB_CACHE_TTL_DAYS",
      "required": false
    },
    {
      "description": "",
      "name": "TMDB_REFRESH_CRON",
      "required": false
    }
  ],
  "homepage": "https://nself.org/plugins",
  "language": "go",
  "license": "free",
  "licenseType": "free",
  "license_spdx": "MIT",
  "manifest_version": 2,
  "maturity": "implemented",
  "minNselfVersion": "1.0.0",
  "multiApp": {
    "defaultValue": "primary",
    "isolationColumn": "source_account_id",
    "pkStrategy": "single",
    "supported": true
  },
  "name": "tmdb",
  "permissions": {
    "database": [
      "create",
      "read",
      "update",
      "delete"
    ],
    "filesystem": [
      "logs",
      "cache"
    ],
    "network": [
      "api.themoviedb.org",
      "www.omdbapi.com",
      "api.thetvdb.com",
      "musicbrainz.org"
    ]
  },
  "port": 3122,
  "repository": "https://github.com/nself-org/plugins",
  "requires": {
    "nself": ">=1.0.0"
  },
  "rest_routes": [
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/api/v1/stats"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/confirm"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/health"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/match"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/match-batch"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/queue"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/ready"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/refresh"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/search"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/status"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/sync"
    },
    {
      "auth": "bearer",
      "method": "DELETE",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "PUT",
      "path": "/{id}"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{id}/seasons"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/{id}/seasons"
    },
    {
      "auth": "bearer",
      "method": "GET",
      "path": "/{id}/seasons/{season}/episodes"
    },
    {
      "auth": "bearer",
      "method": "POST",
      "path": "/{id}/seasons/{season}/episodes"
    }
  ],
  "schema": "np_tmdb",
  "service": {
    "compose": "docker-compose.plugin.yml",
    "healthcheck": "/health",
    "kind": "compose",
    "port": 3122
  },
  "status": "stable",
  "tables": [
    "np_tmdb_movies",
    "np_tmdb_tv_shows",
    "np_tmdb_tv_seasons",
    "np_tmdb_tv_episodes",
    "np_tmdb_genres",
    "np_tmdb_match_queue",
    "np_tmdb_webhook_events"
  ],
  "tags": [
    "tmdb",
    "metadata",
    "movies",
    "tv-shows",
    "imdb",
    "tvdb",
    "musicbrainz",
    "media",
    "matching",
    "enrichment"
  ],
  "tier": "free",
  "version": "1.2.13"
}
