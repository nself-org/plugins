#!/usr/bin/env bash
# toolchain-pins drill (P7-CI-43, Epic D24): prints ONE ci.evidence document with one check per row of
# free/ci/toolchain/versions.yaml. A pinned artifact that is no longer downloadable FAILS its check. A newer
# upstream release is an ADVISORY finding (check passes with findings=1, never a failure). No Renovate, no
# GitHub App: this weekly job is the freshness signal.
# Inputs:  TOOLCHAIN_VERSIONS (default: free/ci/toolchain/versions.yaml of this checkout), DRILL_MIRROR
#          (test hook: serve https://HOST/PATH from $DRILL_MIRROR/HOST/PATH), GITHUB_TOKEN (optional, raises the
#          GitHub API rate limit), GITHUB_EVENT_NAME / GITHUB_RUN_ID (set on a runner).
# Outputs: the evidence JSON on stdout; progress on stderr. Exit 0 when no check failed, 1 otherwise,
#          2 when versions.yaml cannot be read or a tool (curl, jq, yq) is missing.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
versions=${TOOLCHAIN_VERSIONS:-$root/free/ci/toolchain/versions.yaml}
for tool in curl jq yq; do
	command -v "$tool" >/dev/null || { echo "toolchain-pins: $tool is required" >&2; exit 2; }
done
yq --version 2>&1 | grep -qi mikefarah || { echo "toolchain-pins: mikefarah yq v4 is required" >&2; exit 2; }
[ -r "$versions" ] || { echo "toolchain-pins: cannot read $versions" >&2; exit 2; }

work=$(mktemp -d "${TMPDIR:-/tmp}/toolchain-pins.XXXXXX")
trap 'rm -rf "$work"' EXIT
started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
t0=$(date +%s)

# u URL: the URL, or its mirror when DRILL_MIRROR is set.
u() {
	if [ -n "${DRILL_MIRROR:-}" ]; then printf '%s/%s' "${DRILL_MIRROR%/}" "${1#https://}"; else printf '%s' "$1"; fi
}
proto='=https'
[ -n "${DRILL_MIRROR:-}" ] && proto='=https,http' # the test mirror is plain http on loopback
curl_opts=(--silent --show-error --location --retry 3 --max-time 60 --proto "$proto")
sha() { sha256sum "$@" 2>/dev/null || shasum -a 256 "$@"; }
get() { # get URL: body on stdout
	local auth=()
	[[ "$1" == https://api.github.com/* && -n "${GITHUB_TOKEN:-}" ]] && auth=(-H "Authorization: Bearer $GITHUB_TOKEN")
	curl "${curl_opts[@]}" --fail ${auth[@]+"${auth[@]}"} "$(u "$1")"
}
# head_ok URL: the artifact is downloadable. Some CDNs refuse HEAD on a signed URL, so fall back to a 1-byte GET.
head_ok() {
	curl "${curl_opts[@]}" --fail --head --output /dev/null "$(u "$1")" ||
		curl "${curl_opts[@]}" --fail --range 0-0 --output /dev/null "$(u "$1")"
}

# latest TYPE REF: newest upstream version on stdout, empty when the feed cannot be read.
latest() {
	case "$1" in
	github) get "https://api.github.com/repos/$2/releases/latest" 2>/dev/null | jq -r '.tag_name // empty' ;;
	go) get "https://go.dev/dl/?mode=json" 2>/dev/null | jq -r '[.[] | select(.stable)][0].version // empty' ;;
	node) get "https://nodejs.org/dist/index.json" 2>/dev/null | jq -r '[.[] | select(.lts)][0].version // empty' ;;
	rust) get "https://static.rust-lang.org/dist/channel-rust-stable.toml" 2>/dev/null | sed -n '/^\[pkg\.rust\]/,/^\[/{s/^version = "\([^ "]*\).*/\1/p;}' | head -1 ;;
	gomodule) get "https://proxy.golang.org/$2/@latest" 2>/dev/null | jq -r '.Version // empty' ;;
	*) return 0 ;;
	esac
}
norm() { local v=${1#v}; printf '%s' "${v#go}"; }
newer() { # newer CURRENT LATEST: true when LATEST sorts after CURRENT
	[ -n "$2" ] && [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$2" ]
}

# oci_ok REF DIGEST: the digest still resolves (anonymous Docker Hub pull token; docker.io images only).
oci_ok() {
	local repo=${1#docker.io/}
	local tok
	tok=$(get "https://auth.docker.io/token?service=registry.docker.io&scope=repository:$repo:pull" | jq -r .token) || return 1
	curl "${curl_opts[@]}" --fail --head --output /dev/null -H "Authorization: Bearer $tok" \
		-H 'Accept: application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json' \
		"$(u "https://registry-1.docker.io/v2/$repo/manifests/$2")"
}

checks=$work/checks.ndjson
: >"$checks"
emit() { # emit ID TOOL VERSION REQUIRED RESULT FINDINGS EXCERPT [REASON]
	jq -nc --arg id "toolchain-pins.$1" --arg tool "$2" --arg ver "$3" --argjson req "$4" --arg result "$5" \
		--argjson findings "$6" --arg excerpt "$7" --arg reason "${8:-}" '
		{id: $id, job_id: "toolchain-pins", kind: "toolchain", tool: $tool, tool_version: (if $ver == "" then null else $ver end),
		 required: $req, substantive: true, result: $result, findings: $findings, excerpt: $excerpt[0:4000], log_ref: null}
		+ (if $reason == "" then {} else {reason: $reason} end)' >>"$checks"
}

rows=$(yq -o=json -I=0 '.rows[]' "$versions")
while IFS= read -r row; do
	[ -n "$row" ] || continue
	name=$(jq -r .name <<<"$row")
	kind=$(jq -r .kind <<<"$row")
	version=$(jq -r '.version // ""' <<<"$row")
	echo "toolchain-pins: $name" >&2
	case "$kind" in
	image)
		if [ "$(jq -r .status <<<"$row")" != pinned ]; then
			emit "$name" "$name" "" false skip 0 "image row is $(jq -r .status <<<"$row"); the first publish is owner-named"
		elif oci_ok "$(jq -r .image <<<"$row")" "$(jq -r .digest <<<"$row")"; then
			emit "$name" "$name" "" true pass 0 "pinned image digest still resolves"
		else
			emit "$name" "$name" "" true fail 1 "pinned image digest $(jq -r .digest <<<"$row") no longer resolves"
		fi
		continue ;;
	base-image)
		if oci_ok "$(jq -r .image <<<"$row")" "$(jq -r .digest <<<"$row")"; then
			emit "$name" "$name" "$version" true pass 0 "digest still resolves"
		else
			emit "$name" "$name" "$version" true fail 1 "pinned digest $(jq -r .digest <<<"$row") no longer resolves"
		fi
		continue ;;
	esac
	gone=()
	while IFS= read -r src; do
		url=$(jq -r .url <<<"$src")
		head_ok "$url" || gone+=("$(jq -r '.os + "/" + .arch' <<<"$src")")
	done < <(jq -c '.sources[]' <<<"$row")
	if [ "${#gone[@]}" -gt 0 ]; then
		emit "$name" "$name" "$version" true fail "${#gone[@]}" "pinned artifact no longer downloadable for: ${gone[*]}"
		continue
	fi
	new=$(latest "$(jq -r .upstream.type <<<"$row")" "$(jq -r .upstream.ref <<<"$row")" || true)
	new=$(norm "$new")
	if [ -z "$new" ]; then
		emit "$name" "$name" "$version" true pass 0 "artifacts downloadable; upstream feed not readable" advisory.data_offline
	elif newer "$version" "$new"; then
		emit "$name" "$name" "$version" true pass 1 "advisory: $new is available (pinned $version)"
	else
		emit "$name" "$name" "$version" true pass 0 "pinned $version is current and downloadable"
	fi
done <<<"$rows"

finished=$(date -u +%Y-%m-%dT%H:%M:%SZ)
revision=$(git -C "$root" rev-parse HEAD 2>/dev/null || true)
[[ "$revision" =~ ^[0-9a-f]{40}$ ]] || revision=0000000000000000000000000000000000000000
first=$(git -C "$root" rev-list --max-parents=0 HEAD 2>/dev/null | tail -1 || true)
repo_id="local:$(printf '%s' "${first:-none}" | sha | cut -d' ' -f1)"
dirty=false
[ -n "$(git -C "$root" status --porcelain --untracked-files=no 2>/dev/null || true)" ] && dirty=true
case "${GITHUB_EVENT_NAME:-}" in schedule | push | pull_request) trigger=$GITHUB_EVENT_NAME ;; workflow_dispatch) trigger=manual ;; *) trigger=local ;; esac
platform=$(uname -s | tr A-Z a-z)/$(uname -m | sed -e s/x86_64/amd64/ -e s/aarch64/arm64/)
cfg=$(sha "$versions" | cut -d' ' -f1)

jq -s --arg revision "$revision" --arg repo "$repo_id" --arg run "${GITHUB_RUN_ID:-toolchain-pins-$t0}" --arg trigger "$trigger" \
	--arg cfg "$cfg" --argjson dirty "$dirty" --arg platform "$platform" --arg host "$(hostname)" \
	--arg provider "$([ -n "${GITHUB_RUN_ID:-}" ] && echo github || echo local)" \
	--arg started "$started" --arg finished "$finished" --argjson ms "$((($(date +%s) - t0) * 1000))" \
	--slurpfile rows <(yq -o=json '.rows' "$versions") '
	. as $checks
	| ($checks | map(select(.result == "fail")) | length) as $fail
	| {
	  schema: "ci.evidence/v1", revision: $revision, repo_id: $repo, run_id: $run,
	  pipeline: {id: "drills", name: "drills", kind: "drill"}, job: "toolchain-pins",
	  trigger: $trigger, source_trust: "owner", policy_digest: "none",
	  input_digests: {config: $cfg, generated: [], lockfiles: []},
	  worktree_state: (if $dirty then "dirty" else "clean" end), tracked_changes_digest: null,
	  binding: (if $dirty then {state: "unbound", reason: "dirty"} else {state: "bound", reason: null} end),
	  runner: {id: $host, provider: $provider, platform: $platform, isolation: "process"},
	  producer: {kind: "self-reported", version: "toolchain-pins/1"},
	  timings: {queued_at: null, started_at: $started, finished_at: $finished, duration_ms: $ms},
	  tool_versions: ($rows[0] | map(select(.kind == "tool") | {key: .name, value: .version}) | from_entries),
	  checks: $checks, artifacts: [], retries: [],
	  selection: {mode: "full", reason: "selection.full_required", digest: "none"},
	  result: (if $fail > 0 then "fail" else "pass" end),
	  counts: {pass: ($checks | map(select(.result == "pass")) | length), fail: $fail,
	           skip: ($checks | map(select(.result == "skip")) | length), error: 0, total: ($checks | length)},
	  freshness: (if $dirty then {state: "unknown", reason: null} else {state: "current", reason: null} end),
	  signature: {kind: "coordinator-recorded"}
	}' "$checks" | tee "$work/evidence.json"

[ "$(jq -r .result "$work/evidence.json")" = pass ]
